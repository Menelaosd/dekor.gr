<div class="product product-grid col-lg-3 col-md-3 col-sm-6 col-xs-6" itemprop="itemListElement" itemscope="" itemtype="http://schema.org/Product">
    <div class="product-media">
        {% if product.percentage %}
            <span class="sale-percentage">{{ product.percentage }}&#37;</span>
        {% endif %}
        <a href="{{ product.href }}">
            <div class="product-thumbnail">
                <img id="p_{{product.product_id}}" itemprop="image" alt="{{ product.name }}" src="{{ product.thumb }}" class="current">
            </div>
        </a>
        <div class="product-actions product-actions-left">
            <a onclick="cart.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_cart }}" class="awe-button product-quick-view"><i class="fa fa-shopping-bag"></i></a>
        </div>
        <div class="product-actions">
            <a onclick="wishlist.add('{{ product.product_id }}');" data-toggle="tooltip" title="{{ button_wishlist }}" class="awe-button product-wishlist"><i class="fa fa-heart"></i></a>
        </div>

            <div class="product-body">


        <div class="onomatimi">
                      <div class="product-pnamesec col-md-12">
                        <h2 class="product-name" itemprop="name">
                            <a href="{{ product.href }}">{{ product.name }}</a>
                        </h2>
                    </div>

                    <div class="product-price col-md-12" itemprop="offers" itemscope="" itemtype="http://schema.org/Offer">
                        <meta itemprop="priceCurrency" content="EUR">
                        {% if product.price %}
                            {% if not product.special %}
                                <meta itemprop="price" content="{{ product.price|replace({',': '.', '€': ''}) }}">
                                <span class="amount">{{ product.price }}</span>
                            {% else %}
                                <meta itemprop="price" content="{{ product.special|replace({',': '.', '€': ''}) }}">
                                <span class="amount">{{ product.special }}</span>
                                <del class="amount_before">{{ product.price }}</del>
                            {% endif %}
                        {% endif %}
                       
                    </div>
       
    </div>
<!--             <div class="product-codee">
    <p>{{ text_model }}  {{ product.model }}</p>
</div> -->
<div class="ifasmata">
 {% if product.option %}
          {% for option_value in product.option %}
                {% if product.type_option == 'image' %}
                <div id="input-option{{ option.product_option_id }}" class="colors-new-category ">
                    <img src="{{ option_value.image }}" alt="{{ option_value.name }}" class="img-thumbnail" />
                               
                </div>
           {% endif %} 
           {% endfor %}
{% endif %} 
</div>   
        <div class="product-description">
            <p class="more-content" itemprop="description">{{ product.description }}</p>
        </div>


    </div>



        <div class="product-list-actions">
            <a target="_blank" class="btn btn-default" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" ><i class="fa fa-shopping-cart"></i> ΑΓΟΡΑΣΕ ΤΟ</a>
            <a target="_blank" class="btn btn-primary" href="{{ product.href }}"><i class="fa fa-eye"></i> ΔΕΣ ΤΟ</a>
        </div>

    </div>

        <div class="product-deiteto">
            <div class="valtostokalathi col-lg-6 col-md-6 col-sm-6 col-xs-6">
                 <a target="_blank" class="btn btn-default" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');" ><i class="fal fa-shopping-cart"></i>        {% if lang == 'el' %}  
                            <span class="hidden-xs">ΠΡΟΣΘΗΚΗ ΣΤΟ ΚΑΛΑΘΙ</span>
                         {% else %}
                            <span class="hidden-xs">ADD TO CART</span> 
                         {% endif %} 
                 </a>
            </div>
           <div class="favoritam col-lg-6 col-md-6  col-sm-6 col-xs-6">
              <button type="button" data-toggle="tooltip" class="wishara btn btn-default" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><i class="fal fa-heart"></i>
                {% if lang == 'el' %}  
                            <span class="hidden-xs">WHISHLIST</span>
                         {% else %}
                            <span class="hidden-xs">WHISHLIST</span> 
                         {% endif %} 
                </button>
           </div>   

    </div>
    
</div>