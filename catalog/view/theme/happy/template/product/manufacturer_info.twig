{{ header }}
{{ content_top }}
<div id="product-category" class="product-manufacturer">
    <div class="category-head">
        <div class="category-texts">
            <h1 class="category-title">
                {{ heading_title }}
                {% if total_products %}
                    <sup>{{ total_products }}</sup>
                {% endif %}
            </h1>
        </div>
    </div>
    <div class="container-fluid">
        <div class="row">
            {{ column_left }}
            <div id="content" class="ho_products col-md-12 col-xs-12">
                {% if products %}
                    <div class="product_helpers">
                        <div class="row">
                            <div class="col-md-4 col-sm-6 hidden-xs">
                                <div class="btn-group btn-group-sm">
                                <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
                                <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
                                </div>
                            </div>
                            <div class="col-md-8 col-sm-6">
                                <div class="form-group pull-left input-group input-group-sm">
                                    <label for="input-sort">{{ text_sort }}</label>
                                    <select id="input-sort" class="form-control" onchange="location = this.value;">
                                      {% for sorts in sorts %}
                                      {% if sorts.value == '%s-%s'|format(sort, order) %}
                                      <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                                      {% else %}
                                      <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                                      {% endif %}
                                      {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group pull-right text-right input-group input-group-sm">
                                    <label for="input-limit">{{ text_limit }}</label>
                                    <select id="input-limit" class="form-control" onchange="location = this.value;">
                                      {% for limits in limits %}
                                      {% if limits.value == limit %}
                                      <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                                      {% else %}
                                      <option value="{{ limits.href }}">{{ limits.text }}</option>
                                      {% endif %}
                                      {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="product_loop">
                        <div class="row"> 
                            {% for product in products %}
                                {{ include('happy/template/hostore/product_blocks/product_one.twig') }}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="product_results">
                        <div class="row">
                            <div class="pagination_list col-sm-6 text-left">{{ pagination }}</div>
                            <div class="pagination_results col-sm-6 text-right">{{ results }}</div>
                        </div>
                    </div>
                {% else %}
                    <p>{{ text_empty }}</p>
                    <div class="buttons">
                        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{{ footer }} 