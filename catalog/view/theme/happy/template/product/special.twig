{{ header }}
{% set class = 'no-image' %}
<div class="category-header {{class}}">
	<div class="container breadcrumbs-container container-max-width">
	  <ul class="breadcrumb">
		{% for breadcrumb in breadcrumbs %}
		<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
		{% endfor %}
	  </ul>
	</div>
	<div class="container caption-container container-max-width">
		<div class="category-caption-box">
		<h2 class="page-title">{{ heading_title }}</h2>
		</div>
	</div>
</div>
<div id="product-category" class="container container-max-width">
      {% if products %}
		<div class="visible-xs visible-sm">
		<div class="row">
		<div class="category-filters category-filters-mobile col-xs-12">
			<div class="input-filters">
				<a href="#" class="filters-toggle visible-xs visible-sm"><i class="fa fa-filter" aria-hidden="true"></i> ΦΙΛΤΡΑ</a>
			</div>
          <div class="input-sort">
            <label for="input-sort-mobile"><i class="fa fa-sort" aria-hidden="true"></i></label>
            <select id="input-sort-mobile" onchange="location = this.value;">
              {% for sorts in sorts %}
              {% if sorts.value == '%s-%s'|format(sort, order) %}
              <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
              {% else %}
              <option value="{{ sorts.href }}">{{ sorts.text }}</option>
              {% endif %}
              {% endfor %}
            </select>
          </div>
		</div>
		</div>
			<script type="text/javascript">
				$('.filters-toggle').on('click',function(e){
					e.preventDefault();
					$('.bf-panel-wrapper').slideToggle(100);
				});
			</script>
		</div>
      {% endif %}
	<div class="row">
		{{ column_left }}
		{% if column_left and column_right %}
		{% set class = 'col-sm-6' %}
		{% elseif column_left or column_right %}
		{% set class = 'col-sm-10' %}
		{% else %}
		{% set class = 'col-sm-12' %}
		{% endif %}
		<div id="content" class="{{ class }}">{{ content_top }}
			{% if products %}
				<div class="category-filters hidden-xs hidden-sm">
				  <div class="input-sort">
					<label for="input-sort">{{ text_sort }}</label>
					<select id="input-sort" onchange="location = this.value;">
					  {% for sorts in sorts %}
					  {% if sorts.value == '%s-%s'|format(sort, order) %}
					  <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
					  {% else %}
					  <option value="{{ sorts.href }}">{{ sorts.text }}</option>
					  {% endif %}
					  {% endfor %}
					</select>
				  </div>
				  <div class="input-limit">
					<label for="input-limit">{{ text_limit }}</label>
					<select id="input-limit" onchange="location = this.value;">
					  {% for limits in limits %}
					  {% if limits.value == limit %}
					  <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
					  {% else %}
					  <option value="{{ limits.href }}">{{ limits.text }}</option>
					  {% endif %}
					  {% endfor %}
					</select>
				  </div>
				</div>
				<div class="product_loop">
					<div class="row products-row"> 
						{% for product in products %}
							<div class="product product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12">
								{{ include('happy/template/hostore/product_blocks/product_owl.twig') }}
							</div>
						{% endfor %}
					</div>
				</div>
				<div class="pagination-wrap">{{ pagination }}</div>
			{% endif %}
			{% if not categories and not products %}
				<p>{{ text_empty_categories }}</p>
				<div class="buttons">
				<div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
				</div>
			{% endif %}  
		</div>
	</div>
</div>
<script type="text/javascript">
	$(document).ready(function(){
		$('.box-heading').html('<h3>Φίλτρα</h3>');
	});
</script>
{{ footer }} 