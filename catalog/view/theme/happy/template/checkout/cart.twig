{{ header }}
<div id="checkout-cart" class="container-fluid">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if attention %}
  <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ attention }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  
  
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
	  <div class="buttons clearfix">
		<div class="pull-left"><a href="{{ continue }}" class="btn btn-default"><i class="far fa-chevron-left"></i> {{ button_shopping }}</a></div>
		<div class="pull-right"><a href="{{ checkout }}" class="btn btn-primary">{{ button_checkout }}</a></div>
	  </div>
      <h1>Το καλάθι μου</h1>
      <form action="{{ action }}" method="post" enctype="multipart/form-data">
		<div class="cart-products">
		{% for product in products %}
			<div class="cart-product-block">
				<div class="cart-product-image">
					<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}"/></a>
				</div>
				<div class="cart-product-description">
					<div class="cart-product-description-wrapper">
						<h3>
						<a href="{{ product.href }}">{{ product.name }}
						{% if product.option %}
						{% for option in product.option %} <br />
						 - <small>{{ option.name }}: {{ option.value }}</small> 
						{% endfor %}
						{% endif %}
						</a> 
						
						{% if not product.stock %} <span class="text-danger">***</span> {% endif %}
						</h3>
						<div class="cart-product-model">{{ product.model }}</div>
					</div>
					<div class="cart-product-price">
							<span class="price-current">{{ product.price_tax }}</span>
					</div>
				</div>
				<div class="cart-product-quantity-total">
					<div class="cart-product-quantity">
						<button class="button-minus" data-dir="dwn">-</button>
						<input type="text" name="quantity[{{ product.cart_id }}]" value="{{ product.quantity }}" size="1" class="form-control" />
						<button class="button-plus" data-dir="up">+</button>
					</div>
					<div class="cart-product-total">
						<span class="cart-product-total-label">{{ text_total_label }}</span>{{ product.total_tax }}
					</div>
				</div>
				<div class="cart-product-remove">
					<div class="cart-product-remove-button">
						<button type="button" title="{{ button_remove }}" onclick="cart.remove('{{ product.cart_id }}');"><i class="fas fa-trash"></i></button>
					</div>
				</div>
			</div>
		{% endfor %}
		</div>
		<div class="cart-products-totals">
			{% if points_text %}
			<div class="cart-products-points_total">
			<span class="points-label">{{ text_points_total }}</span>: <i class="fas fa-star"></i> {{ points_text }}
			</div>
			{% endif %}
			<div class="cart-products-total">
            {% for total in totals %}
			<div class="cart-total {{ total.code }}">
				<span class="cart-total-label">{{ total.title }}:</span>
				<span class="cart-total-price">{{ total.text }}</span>
			</div>
            {% endfor %}
			</div>
		</div>
		
		{#
		{% if freeshipping %}
			<div class="freeshipping-banner">
				<div class="freeshipping-banner-wrap">
					<div class="freeshipping-icon">
						<i class="fas fa-truck"></i>
					</div>
					<div class="freeshipping-text">
					Υπολείπονται <span>{{ freeshipping }}</span> για να κερδίσετε <b>δωρεάν μεταφορικά</b> για την αγορά σας! <b>Προσθέστε κάτι ακόμα στο καλάθι σας</b> για να βγείτε <b>κερδισμένοι</b>!
					</div>
				</div>
			</div>
		{% endif %}
		#}
		
		<div class="cart-products-footer">
			{% if modules %}
			<div class="cart-points-form">
				<div class="cart-points-form-wrap">
					<div id="accordion">
					{% for module in modules %}
					{{ module }}
					{% endfor %}
					</div>
				</div>
			</div>
			{% endif %}
		</div>
      </form>	  
      <div class="buttons clearfix">
        <div class="pull-left"><a href="{{ continue }}" class="btn btn-default"><i class="far fa-chevron-left"></i> {{ button_shopping }}</a></div>
        <div class="pull-right"><a href="{{ checkout }}" class="btn btn-primary">{{ button_checkout }}</a></div>
      </div>
      {{ content_bottom }}
	  </div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$(document).on('click', '.button-minus,.button-plus', function (e) {  
	e.preventDefault();
    var btn = $(this),
        oldValue = btn.closest('.cart-product-quantity').find('input').val().trim(),
        newVal = 1;
            
    if (btn.attr('data-dir') == 'up') {
        newVal = parseInt(oldValue) + 1;
    } else {
        if (oldValue > 1) {
            newVal = parseInt(oldValue) - 1;
        } else {
            newVal = 1;
        }
    }
    btn.closest('.cart-product-quantity').find('input').val(newVal).change();	
});

$(document).on('change', '.cart-product-quantity input', function (e) {
	clearTimeout($.data(this, 'timer'));
	$(this).data('timer', setTimeout(update_cart_form, 1000));
});

function update_cart_form() {
	$('#checkout-cart').find('form').submit();
}
        


//-->
</script>
{{ footer }} 