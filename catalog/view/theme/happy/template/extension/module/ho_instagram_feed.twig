{% if(posts) %}
	<div class="flat instagro">
		
		
		<div class="hoInstagramFeed row">
				<div class="hoInstaPost col-xs-6 col-sm-2 col-md-2 insta-first"><img src="catalog/view/theme/happy/image/Instagram1st.png"></div>
				{% for post in posts|slice(0,5) %}
				<div class="hoInstaPost col-xs-6 col-sm-2 col-md-2">
					<a href="{{ post.link }}" target="_blank">
						<div class="hoInstaPostCaption">
							<!--<div class="hoInstaPostCaptionInner">
								<div class="flat text-center">{{ post.user }}</div>
								<div class="flat text-center">{{ post.likes }} LIKES</div>
							</div>-->
						</div>
						<img src="{{ post.img_high }}" class="img-responsive" />
					</a>
				</div>
				
				{% endfor %}
		</div>	

		<script type="text/javascript" src="catalog/view/javascript/isotope.pkgd.min.js"></script>
		<script type="text/javascript">
			$(window).load(function(){
				var $grid = $('.hoInstagramFeed').isotope({
					itemSelector: '.hoInstaPost'
				});
			})
		</script>
	</div>
{% endif %}