<ul class="nav navbar-nav">
    {% macro render_menu(items, current_path, parent_name, store_id) %}
        {% for item in items %}
            {% set active = (current_path and (current_path == item.category_id or current_path starts with (item.category_id ~ '_'))) %}
            <li class="{% if item.children %}dropdown {% endif %}{% if active %}active{% endif %}">
                <a href="{{ item.href }}"
                   {% if item.children %}class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"{% endif %}>
                    {% if store_id == 2 and parent_name == 'Τελετουργικά Έλαια' and item.thumb %}
                        <span class="hol-category-menu-thumb"><img src="{{ item.thumb }}" alt="{{ item.name }}"></span>
                        <span class="hol-category-menu-title">{{ item.name }}</span>
                    {% else %}
                        {{ item.name }}
                    {% endif %}
                    {% if item.children %}<span class="caret"></span>{% endif %}
                </a>
                {% if item.children %}
                    <ul class="dropdown-menu{% if store_id == 2 and item.name == 'Τελετουργικά Έλαια' %} hol-category-image-tiles{% endif %}">
                        {{ _self.render_menu(item.children, current_path, item.name, store_id) }}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    {% endmacro %}
    {{ _self.render_menu(nav, current_path, '', store_id) }}
</ul>