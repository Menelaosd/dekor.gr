<div class="categories-home">
	<h3 class="module-title">ΚΑΤΗΓΟΡΙΕΣ</h3>
	<div class="categories-wrap">
		<div class="container">
			<div class="row">
				{% for category in categories %}
					
					{% set class = 'col-xs-12 col-sm-12 col-md-4 col-lg-4' %}
					{% if loop.index > 3 %}
						{% set class = 'col-xs-12 col-sm-12 col-md-3 col-lg-3' %}
					{% endif %}
					<div class="category-block-outter {{class}}">
						<div class="category-block">
							<a href="{{ category.href }}">
							<img src="{{ category.image }}">
							</a>
							<h4><a href="{{ category.href }}">{{ category.name }}</a>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>
