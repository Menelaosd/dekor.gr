<div class="panel-panel-default">


                             {% if lang == 'el' %}  
    <h3>ΚΑΤΗΓΟΡΙΕΣ</h3>
     {% else %}
    <h3>CATEGORIES</h3> 

{% endif %} 
    <div class="list-group">
        {% set filter_count = 0 %}
        {% for filter_group in filter_groups %}
           
            <div class="list-group-item">
                 <a class="list-group-iteme">{{ filter_group.name }}</a>
                <div id="filter-group{{ filter_group.filter_group_id }}">
                    {% for filter in filter_group.filter %}
                        <div class="checkbox">
                            <label>
                                {% if filter.filter_id in filter_category %}
                                    {% set filter_count = filter_count + 1 %}
                                    <input type="checkbox" name="filter[]" value="{{ filter.filter_id }}" checked="checked" />
                                      <span class="checkmark"></span>
                                    {{ filter.name }}
                                {% else %}
                                    <input type="checkbox" name="filter[]" value="{{ filter.filter_id }}" />
                                      <span class="checkmark"></span>
                                    {{ filter.name }}
                                {% endif %}
                            </label>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
    {% if filter_count > 0 %} 
        <div class="panel-footer">
            <button type="button" id="clear-filter" class="btn btn-primary">ΑΦΑΙΡΕΣΗ ΦΙΛΤΡΩΝ</button>
        </div>
    {% endif %}
</div>
<script type="text/javascript"><!--
    $('#clear-filter').on('click', function() {
        location = '{{ action }}';
    });
    $('.checkbox input').on('change', function() {
        filter = [];
        $('input[name^=\'filter\']:checked').each(function(element) {
            filter.push(this.value);
        });
        location = '{{ action }}&filter=' + filter.join(',');
    });
//--></script> 
