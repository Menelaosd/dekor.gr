<div id="cart-container" class="modal">
	<div class="modal-dialog">
		<div class="modal-inner">
			<div class="cart-content">
				<div class="modal-heading">
					<button type="button" id="close-cart" class="close">
						<i class="fal fa-times"></i>
					</button>
					{{ text_cart }}
				</div>
				<div class="modal-body">
					{% if products or vouchers %}
						<div class="cart_products">
							{% for product in products %}
								<div class="cart_row">
									{% if product.thumb %}
										<div class="cart_row_image">
											<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-fluid" /></a>
										</div>
										<div class="cart_row_info">
											<h4>{{ product.name }}</h4>
											<div class="cart_row_subtotal">{{ product.quantity }} x {{ product.price_tax }}</div>
											<div class="cart_row_total">{{ product.total_tax }}</div>
										</div>
										<div class="cart_row_remove">
											<a href="#" onclick="cart.remove('{{ product.cart_id }}'); return false;" title="{{ button_remove }}">
												<i class="far fa-times-circle"></i>
											</a>
										</div>
									{% endif %}
								</div>
							{% endfor %}
						</div>
						<div class="cart_totals">
							{% for total in totals %}
								{% if total.code == 'sub_total' or total.code == 'tax' or total.code == 'total' %}
								<div class="cart_totals_row">
									<span class="col">{{ total.title }}:</span>
									<span class="col text-right">{{ total.text }}</span>
								</div>  
								{% endif %}
							{% endfor %}
						</div>
					{% else %}
						<div class="cart_empty">
							<i class="fal fa-info-circle"></i>
							{{ text_empty }}
						</div>
					{% endif %}
				</div>
				<div class="modal-footer">
					<a href="{{ cart }}" class="btn btn-block btn-primary show-cart-button">{{ text_cart }}</a>
					{% if products or vouchers %}
						<a href="{{ checkout }}" class="btn btn-block btn-primary buy-now-button">{{ text_checkout }}</a>
					{% else %}
						<a href="{{ checkout }}" class="btn btn-block btn-primary buy-now-button disabled">{{ text_checkout }}</a>
					{% endif %}
					{#
					<a href="#"  id="close-cart-footer" class="btn btn-block btn-primary continue-cart-button"><i class="far fa-chevron-left"></i> {{ button_shopping }}</a>
					#}
				</div>
			</div>
		</div>
	</div>
</div>

