{# dekor: the old "rz-stuck" condense script is gone — the header is not sticky, so shrinking it at 90px only made the page jump #}
<script>/* dekor: sticky header without any jump.
   desktop (>=992px): the whole header row (logo, search, account, cart + menu) docks at the top as it is, the moment it reaches the top.
   phones/tablets: once the header has scrolled out of view, a compact bar (burger, logo, search icon, cart) slides in.
   A slot right after the header keeps its exact height, so the page never moves. */
(function(){var w=document.querySelector('header .header-wrapper');if(!w)return;var b=document.body,c='dk-hd-docked',cm='dk-hd-compact';
/* the side cart is a modal: keep it at body level so the docked header can never trap it under the dark backdrop */
var cc=document.getElementById('cart-container');if(cc&&cc.parentNode!==b){b.appendChild(cc);}
var slot=document.createElement('div');slot.id='dk-hd-slot';slot.style.height='0px';w.parentNode.insertBefore(slot,w.nextSibling);
function desk(){return window.innerWidth>=992;}
function undock(){b.classList.remove(c);b.classList.remove(cm);slot.style.height='0px';}
function onScroll(){var docked=b.classList.contains(c),r;
 if(!docked){r=w.getBoundingClientRect();
  if(desk()?r.top<=0:r.bottom<=0){slot.style.height=r.height+'px';b.classList.add(c);if(!desk()){b.classList.add(cm);}}}
 else{r=slot.getBoundingClientRect();if(b.classList.contains(cm)?r.bottom>0:r.top>0){undock();}}}
onScroll();window.addEventListener('scroll',onScroll,{passive:true});window.addEventListener('resize',function(){undock();onScroll();});
/* compact bar: the search icon opens the normal search (full-screen sheet on phones) */
var sb=document.querySelector('.dk-sticky-search');if(sb){sb.addEventListener('click',function(){var i=document.querySelector('#search input[name="search"]'),btn=document.querySelector('#search button');
 if(window.innerWidth<768&&btn){btn.click();return;}undock();window.scrollTo(0,0);if(i){setTimeout(function(){i.focus();},60);}});}})();</script>

