    {% endfor %}
</head>
<body class="{{ page_class }}">
	<div class="ho_wrapper">   
		<header>
			<!-- UTILITY BAR -->
			<div class="dk-util">
				<div class="dk-util-in">
					<div class="dk-util-left">
						<a href="tel:{{ telephone }}" class="dk-util-tel"><i class="fas fa-phone"></i> {{ telephone }}</a>
						<span class="dk-util-sep dk-util-sec">|</span>
						<span class="dk-util-sec">Αποστολή και στην Κύπρο</span>
					</div>
					<div class="dk-util-right">
						<a href="index.php?route=account/login" class="dk-util-reg"><i class="fas fa-user"></i> {% if logged %}Ο Λογαριασμός μου{% else %}Εγγραφή | Είσοδος{% endif %}</a>
						<div class="header-langs">
							<div class="dropdown language-dropdown">
								<button class="btn btn-default dropdown-toggle" type="button" id="languageDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
									<img id="active-flag" src="https://flagcdn.com/w20/gr.png" alt="Greek" class="language-flag">
									<span id="active-label" class="language-label">ΕΛ</span>
									<span class="caret"></span>
								</button>
								<ul class="dropdown-menu" aria-labelledby="languageDropdown" id="language-menu"></ul>
							</div>
							<div id="google_translate_element"></div>
						</div>
					</div>
				</div>
			</div>
			<!-- HEADER ROW -->
			<div class="header-wrapper">
				<div class="dk-hd">
					<a class="burger-box mmenu_opener dk-mobToggle" href="#mmenu" title="Menu"><div class="burgers"></div></a>
					<a href="{{ home }}" class="logo dk-logo" title="{{ name }}"><img src="{{ logo }}" alt="{{ name }}"></a>
					<div class="header-mid dk-search">{{ search }}</div>
					<div class="header-right dk-actions">
						<a href="index.php?route=account/login" class="dk-acct" title="Ο Λογαριασμός μου"><i class="fas fa-user"></i><span class="dk-acct-lbl">Ο Λογαριασμός μου</span></a>
						<a id="wishlist-total" href="{{ wishlist }}" class="dk-wish" title="Αγαπημένα"><i class="fas fa-heart"></i><span class="dk-wishtext">{{ text_wishlist }}</span></a>
						{{ cart }}
					</div>
				</div>
				{% if not mobile %}
					<div id="desk-menu" class="dk-navrow visible-lg visible-md">
						<nav class="main-menu">{{ menu }}</nav>
					</div>
				{% endif %}
			</div>
			{% if mobile %}
				<div class="mmenuparent" style="display:none;"><div id="mmenu">{{ menu }}</div></div>
			{% endif %}
			<div class="hidden">
				<ul class="mobile-custom-submenu">
					<li class="menu-separator mm-navbar"><a class="mm-navbar__title">ΛΟΓΑΡΙΑΣΜΟΣ</a></li>
					<li><a href="index.php?route=account/login"><i class="fas fa-user"></i>{{ text_account }}</a></li>
					<li><a href="index.php?route=checkout/cart"><i class="fa fa-shopping-cart"></i>{{ text_cart }}</a></li>
					<li><a href="{{ wishlist }}"><i class="fas fa-heart"></i>{{ text_wishlist }}</a></li>
					<li><a href="{{ contact }}"><i class="fas fa-envelope"></i>{{ text_contact }}</a></li>
				</ul>
			</div>
		</header>
<script>(function(){function s(){if(window.pageYOffset>90){document.body.classList.add("rz-stuck");}else{document.body.classList.remove("rz-stuck");}}window.addEventListener("scroll",s,{passive:true});s();})();</script>

	   <script>
			$(document).ready(function() {
				$("#mmenu").mmenu({
					"extensions": [
						// "fx-panels-zoom",
						// "pagedim-black"
					],
					"navbar": {
						"title": "NAVIGATION"
					}
				});
				var API = $("#mmenu").data( "mmenu" );
				var li = '';
				$('ul.mobile-custom-submenu').each(function(){
					li += $(this).html();
				});
				$("#mmenu").find( ".mm-listview" ).first().append( li );
				$("#mmenu").find('.menu-separator').prev('li').addClass('last-li-item');
				//API.initPanels( $("#mmenu").find( '.mm-listview' ).first().closest('.mm-panel') );
				$(".mmenuparent").fadeIn(100);
			});
		</script>