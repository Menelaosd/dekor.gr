    {% if keywords %}
        <meta name="keywords" content="{{ keywords }}" />
    {% endif %}
    {% for meta in metas %}
        <meta name="{{ meta.meta_name}}" content="{{ meta.content }}" />
    {% endfor %}
	{% if store_id == 2 %}
	    <meta name="theme-color" content="#000" />
	{% else %}
		<meta name="theme-color" content="#000" />
	{% endif %}
