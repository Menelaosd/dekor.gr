/* Loaded only for Apokrifa (store 2), after the shared header/card styles.
   Keep Dekor's palette and layouts untouched. */
:root {
  --rz-accent: #000 !important;
  --rz-accent-2: #333 !important;
  --rz-accent-deep: #000 !important;
  --rz-accent-ink: #fff;
  --rz-gold: #737373;
  --rz-avail: #333 !important;
  --rz-bg: #f7f7f7;
  --rz-surface-2: #f2f2f2;
  --rz-ink: #171717;
  --rz-muted: #686868;
  --rz-border: rgba(0, 0, 0, .10);
  --rz-border-strong: rgba(0, 0, 0, .22);
  --rz-shadow: 0 4px 18px rgba(0, 0, 0, .04);
  --rz-shadow-lg: 0 12px 28px rgba(0, 0, 0, .09);
}

body { background-image: none !important; }

/* The collapsed description fades into its own gray surface, not white. */
.category-header .category-description .readall-hide::after {
  height: 52px;
  background: linear-gradient(to bottom, transparent, var(--rz-surface-2) 95%) !important;
  pointer-events: none;
}
.category-header .category-description .readall-button {
  width: auto;
  min-height: 40px;
  background: #333 !important;
  border: 1px solid #333 !important;
  color: #fff !important;
  -webkit-text-fill-color: #fff !important;
}
.category-header .category-description .readall-button:hover { background: #484848 !important; }
.category-header .category-description .readall-button:focus-visible { outline: 2px solid #686868; outline-offset: 3px; }

/* Light navigation with soft charcoal text and subtle outlines. */
#desk-menu.dk-navrow,
#desk-menu .main-menu,
#desk-menu .main-menu .nav.navbar-nav > li > a,
#desk-menu .main-menu .dropdown-menu,
#desk-menu .main-menu .dropdown-menu > li > a,
#desk-menu .dropdown-megamenu,
#desk-menu .dropdown-megamenu a {
  background: #fff !important;
  background-image: none !important;
  border-color: #d5d5d5 !important;
}
#desk-menu .main-menu a,
#desk-menu .main-menu a *,
#desk-menu .dropdown-megamenu a,
#desk-menu .dropdown-megamenu a * { color: #3b3b3b !important; }
#desk-menu .main-menu .nav.navbar-nav > li > a:hover,
#desk-menu .main-menu .nav.navbar-nav > li.open > a,
#desk-menu .main-menu ul.dropdown-menu > li > a:hover,
#desk-menu .main-menu ul.dropdown-menu > li > a:focus,
#desk-menu .dropdown-megamenu a:hover { background: #f3f3f3 !important; }
#desk-menu.dk-navrow { border: 1px solid #d5d5d5 !important; }
#desk-menu .main-menu .nav.navbar-nav > li + li > a { border-left: 1px solid #e3e3e3 !important; }
#desk-menu .main-menu .dropdown-menu > li > a::before { background: #777 !important; }
#desk-menu .main-menu .dropdown-menu {
  border: 1px solid #d5d5d5 !important;
  box-shadow: 0 8px 20px rgba(0, 0, 0, .07);
}
@media (min-width: 992px) {
  #desk-menu.dk-navrow {
    padding: 0 !important;
    margin-bottom: 10px !important;
    border-color: #dedede !important;
    border-radius: 12px !important;
  }
  #desk-menu::before { display: none; }
  #desk-menu > .main-menu { display: block; width: 100%; }
  #desk-menu > .main-menu > .navbar-nav {
    display: flex !important;
    width: 100%;
    float: none !important;
    align-items: stretch;
  }
  #desk-menu > .main-menu > .navbar-nav::before,
  #desk-menu > .main-menu > .navbar-nav::after { display: none; }
  #desk-menu > .main-menu > .navbar-nav > li {
    display: flex;
    flex: 1 1 auto;
    float: none !important;
    margin: 0 !important;
  }
  #desk-menu > .main-menu > .navbar-nav > li > a {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    gap: 10px;
    padding: 15px 18px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1.35;
    border-radius: 0 !important;
  }
  #desk-menu > .main-menu > .navbar-nav > li + li > a { border-left-color: #ededed !important; }
  #desk-menu > .main-menu > .navbar-nav > li:first-child > a { border-radius: 11px 0 0 11px !important; }
  #desk-menu > .main-menu > .navbar-nav > li:last-child > a { border-radius: 0 11px 11px 0 !important; }
  #desk-menu > .main-menu > .navbar-nav > li > a > .caret {
    position: static;
    margin: -4px 0 0;
    width: 5px;
    height: 5px;
    flex-basis: 5px;
    opacity: .65;
  }
  #desk-menu > .main-menu > .navbar-nav > li > ul.dropdown-menu {
    display: none !important;
    top: 100%;
    left: 0 !important;
    right: auto !important;
    width: 310px !important;
    max-width: calc(100vw - 32px);
    column-count: 1 !important;
    margin: 0 !important;
    padding: 8px !important;
    border: 1px solid #e3e3e3 !important;
    border-radius: 0 0 12px 12px !important;
    box-shadow: 0 14px 26px rgba(0, 0, 0, .09) !important;
  }
  #desk-menu > .main-menu > .navbar-nav > li[data-ap-open="true"] > ul.dropdown-menu,
  #desk-menu > .main-menu > .navbar-nav > li:hover > ul.dropdown-menu,
  #desk-menu > .main-menu > .navbar-nav > li:focus-within > ul.dropdown-menu { display: block !important; }
  #desk-menu > .main-menu > .navbar-nav > li[data-ap-open="true"] > a { background: #f5f5f5 !important; }
  #desk-menu > .main-menu > .navbar-nav > li > ul.dropdown-menu > li > a {
    padding: 11px 14px !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
    border-radius: 7px !important;
  }
  #desk-menu > .main-menu > .navbar-nav > li > ul.dropdown-menu > li > a::before { display: none !important; }
  #desk-menu > .main-menu > .navbar-nav > li:nth-last-child(-n+2) > ul.dropdown-menu { left: auto !important; right: 0 !important; }
  #desk-menu > .main-menu > .navbar-nav > li > a:focus-visible { outline: 2px solid #777; outline-offset: -4px; }
}
@media (min-width: 992px) and (max-width: 1199px) {
  #desk-menu > .main-menu > .navbar-nav > li > a { font-size: 13px !important; padding-inline: 10px !important; }
}

