  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-description h3 {
    margin: 0 0 6px !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-price {
    display: block !important;
    padding: 0 !important;
    margin: 8px 0 0 !important;
    font-size: 17px !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-quantity-total {
    grid-area: quantity !important;
    display: flex !important;
    flex-flow: row nowrap !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    flex: none !important;
    margin: 0 !important;
    padding: 12px 0 0 !important;
    border-top: 1px solid #e1e1e1 !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-quantity {
    display: flex !important;
    flex: 0 1 auto !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 5px !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-quantity button {
    flex: 0 0 32px !important;
    width: 32px !important;
    min-width: 32px !important;
    height: 36px !important;
    padding: 0 !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-quantity input {
    flex: 0 0 58px !important;
    width: 58px !important;
    min-width: 58px !important;
    max-width: 58px !important;
    height: 36px !important;
    box-sizing: border-box !important;
    padding: 0 2px !important;
    margin: 0 !important;
    font-size: 14px !important;
