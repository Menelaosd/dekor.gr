  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-total {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    text-align: right !important;
    font-size: 15px !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-remove {
    position: absolute !important;
    top: 8px !important;
    right: 8px !important;
    left: auto !important;
    width: 30px !important;
    height: 30px !important;
    padding: 0 !important;
    margin: 0 !important;
