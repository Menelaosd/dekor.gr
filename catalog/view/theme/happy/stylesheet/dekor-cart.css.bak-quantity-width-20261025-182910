/* DEKOR MOBILE CART COMPACT V1 */
@media (max-width: 767px) {
  body.checkout_cart .cart-products.extvisible-xs {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-block {
    display: grid !important;
    grid-template-columns: 76px minmax(0, 1fr) !important;
    grid-template-areas: "image description" "quantity quantity" !important;
    gap: 12px !important;
    align-items: start !important;
    width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
    position: relative !important;
    padding: 14px 10px !important;
    margin: 0 !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-image {
    grid-area: image !important;
    display: block !important;
    width: 76px !important;
    min-width: 0 !important;
    max-width: 76px !important;
    flex: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-image img {
    display: block !important;
    width: 76px !important;
    height: 76px !important;
    max-width: 100% !important;
    object-fit: contain !important;
  }

  body.checkout_cart .cart-products.extvisible-xs .cart-product-description {
