/* ============================================================================
   PRODUCT PAGE (PDP) redesign — same language as the product & blog cards
   (Geologica text, Roboto Mono accent prices, 20px rounded cards, sage accent).
   Loaded only by product/product.twig, every rule scoped to body.product_product
   so nothing else on the site is affected. Accent comes from --rz-accent, so
   DEKOR stays green and APOKRIFA keeps its own colour.
   ========================================================================== */

body.product_product {
	--pdp-surface: #F6F7F9;
	--pdp-line: var(--rz-border, #ECEEF3);
	--pdp-ink: var(--rz-ink, #111);
	--pdp-muted: var(--rz-muted, #5B5E68);
	--pdp-accent: var(--rz-accent, #618764);
	--pdp-accent-deep: var(--rz-accent-deep, #4C6B50);
	--pdp-radius: var(--rz-radius, 20px);
	--pdp-radius-sm: var(--rz-radius-sm, 12px);
	--pdp-ui: var(--rz-ui, "Geologica", system-ui, sans-serif);
	--pdp-mono: var(--rz-mono, "Roboto Mono", monospace);
}

/* ---------- page frame ---------------------------------------------------- */
body.product_product #product.product-wrap { max-width: 1320px; margin: 0 auto; padding: 28px 0 32px; }
body.product_product .breadcrumbs-container { max-width: 1320px; }
/* two columns with a real gap (custom.css adds gap:1.5rem + margins that made the card wrap below) */
body.product_product #product > .product-wrapper > .row { display: flex !important; flex-wrap: wrap; align-items: flex-start; gap: 28px !important; margin: 0 !important; }
/* Bootstrap 3 clearfix pseudo-elements become flex items and push the info card below the gallery */
body.product_product #product > .product-wrapper > .row::before,
body.product_product #product > .product-wrapper > .row::after { display: none !important; }
body.product_product #product .product-right .row { margin: 0 !important; }
body.product_product #product .product-left.product__images {
	float: none; margin: 0 !important; padding: 0 !important; border: none !important; position: relative !important; top: 0 !important;
}
body.product_product #product .product-right.product-content { float: none; margin: 0 !important; position: static !important; top: auto !important; } /* no sticky: both columns were sticky (custom.css) and jumped at the end of the row */

@media (min-width: 992px) {
	body.product_product #product .product-left.product__images { flex: 0 0 calc(56% - 14px); max-width: calc(56% - 14px); width: calc(56% - 14px); }
	body.product_product #product .product-right.product-content { flex: 0 0 calc(44% - 14px); max-width: calc(44% - 14px); width: calc(44% - 14px); }
}
@media (max-width: 991px) {
	body.product_product #product > .product-wrapper > .row { gap: 0 !important; }
	body.product_product #product .product-left.product__images,
	body.product_product #product .product-right.product-content { flex: 0 0 100%; max-width: 100%; width: 100%; position: static; }
}

/* ---------- gallery ------------------------------------------------------- */
body.product_product .product-left.product__images { position: relative; background: transparent !important; box-shadow: none !important; }
body.product_product .product-left .swiper-viewport {
	background: transparent !important;
	border: none !important;
	border-radius: 0 !important;
	padding: 0 !important;
	box-shadow: none !important;
	overflow: visible;
}
body.product_product .product-left #product_img_gallery {
	background: var(--pdp-surface) !important; border: none !important;
	border-radius: var(--pdp-radius) !important; overflow: hidden;
}
body.product_product .product-left #product_img_gallery .swiper-slide {
	display: flex; align-items: center; justify-content: center;
	aspect-ratio: 1 / 1; background: transparent !important; margin: 0;
}
body.product_product .product-left #product_img_gallery .swiper-slide a { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; }
body.product_product .product-left #product_img_gallery .swiper-slide img {
	width: 100% !important; height: 100% !important; max-height: none !important;
	object-fit: cover; border: none !important; border-radius: 0 !important;
}
/* soft round nav arrows (same as the card sliders) */
body.product_product .product-left .swiper-button-next,
body.product_product .product-left .swiper-button-prev {
	width: 44px; height: 44px; margin-top: -22px; border-radius: 50%;
	background: rgba(255, 255, 255, .92) none !important; box-shadow: 0 2px 10px rgba(17, 17, 17, .08);
}
body.product_product .product-left .swiper-button-next::after,
body.product_product .product-left .swiper-button-prev::after {
	content: ""; position: absolute; top: 50%; left: 50%; width: 9px; height: 9px;
	border-top: 2px solid var(--pdp-ink); border-right: 2px solid var(--pdp-ink);
}
body.product_product .product-left .swiper-button-next::after { transform: translate(-65%, -50%) rotate(45deg); }
body.product_product .product-left .swiper-button-prev::after { transform: translate(-35%, -50%) rotate(-135deg); }
body.product_product .product-left .swiper-button-disabled { opacity: 0 !important; }

/* thumbnails: square tiles under the main image */
body.product_product .product-left .thumb {
	display: grid !important; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 10px;
	margin: 12px 0 0 !important; padding: 0 !important; background: none !important; border: none !important;
}
body.product_product .product-left .thumb .swiper-slide {
	width: auto !important; height: auto !important; margin: 0 !important; padding: 0 !important;
	aspect-ratio: 1 / 1; background: var(--pdp-surface) !important;
	border: 2px solid transparent !important; border-radius: var(--pdp-radius-sm) !important;
	overflow: hidden; opacity: .78; transition: opacity .15s ease, border-color .15s ease;
}
body.product_product .product-left .thumb .swiper-slide:hover { opacity: 1; }
body.product_product .product-left .thumb .swiper-slide.active,
body.product_product .product-left .thumb .swiper-slide.swiper-slide-active { border-color: var(--pdp-accent) !important; opacity: 1; }
body.product_product .product-left .thumb .swiper-slide a { display: block; width: 100%; height: 100%; }
body.product_product .product-left .thumb .swiper-slide img {
	width: 100% !important; height: 100% !important; object-fit: cover; border: none !important; border-radius: 0 !important;
}

/* discount badge (same as the product card) */
body.product_product .pdp-badge {
	position: absolute; top: 16px; left: 30px; z-index: 5;
	width: 54px; height: 54px; border-radius: 50%;
	display: flex; align-items: center; justify-content: center;
	background: var(--pdp-accent); color: #fff; border: 2px solid #fff;
	font: 700 14px/1 var(--pdp-ui); box-shadow: 0 2px 8px rgba(17, 17, 17, .12);
}

/* ---------- info card ----------------------------------------------------- */
body.product_product .product-right.product-content > * { position: relative; }
body.product_product .product-right.product-content {
	background: #fff; border: 1px solid var(--pdp-line) !important; border-radius: var(--pdp-radius) !important;
}
@media (min-width: 992px) {
	body.product_product .product-right.product-content { padding: 30px 32px 26px !important; }
}
@media (max-width: 991px) {
	body.product_product .product-right.product-content { margin-top: 16px !important; padding: 20px 18px !important; }
}

/* title */
body.product_product .product-right > .title,
body.product_product .mobile-top .title {
	font-family: var(--pdp-ui) !important; font-weight: 700 !important; color: var(--pdp-ink) !important;
	font-size: clamp(24px, 2.2vw, 32px) !important; line-height: 1.2 !important; letter-spacing: -.01em;
	margin: 0 0 16px !important; padding: 0 !important; text-transform: none !important; text-align: left;
}
body.product_product .mobile-top { padding: 4px 2px 12px; }
body.product_product .mobile-top .title { font-size: 22px !important; margin: 0 !important; }

/* meta row: code · brand · availability */
body.product_product .product-right .product-details { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin: 0 0 18px; padding: 0 0 18px; border-bottom: 1px solid var(--pdp-line); }
body.product_product .product-right .product-details > div { float: none; width: auto; padding: 0; }
body.product_product .product-right .product-details .clearfix { display: none; }
body.product_product .product-right .product-details > .row { margin: 0; }
body.product_product .product-right .product-details ul.list-unstyled { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 0; padding: 0; }
body.product_product .product-right .product-details ul.list-unstyled li { font: 400 13px/1.4 var(--pdp-mono); color: var(--pdp-muted); }
body.product_product .product-right .product-details ul.list-unstyled li b { font-family: var(--pdp-ui); font-weight: 500; color: var(--pdp-muted); }
body.product_product .product-right .stock-status {
	font: 700 11.5px/1 var(--pdp-ui) !important; text-transform: uppercase; letter-spacing: .06em;
	padding: 8px 13px !important; border-radius: 999px !important;
}
body.product_product .product-right .stock-status i { font-size: 12px; }

/* short description */
body.product_product .product-right .small-description { font: 400 15px/1.65 var(--pdp-ui); color: var(--pdp-muted); margin: 0 0 18px; }

/* ---------- prices (card style) ------------------------------------------- */
body.product_product .product-right .product-prices {
	display: flex; align-items: stretch; margin: 0 0 6px; padding: 0;
	background: var(--pdp-surface); border-radius: var(--pdp-radius-sm); overflow: hidden;
}
body.product_product .product-right .product-prices .price-block { flex: 1 1 0; padding: 16px 18px; margin: 0; min-width: 0; }
body.product_product .product-right .prices-package .price-block + .price-block { border-left: 1px solid var(--pdp-line); }
body.product_product .product-right .product-prices .price,
body.product_product .product-right .product-prices h3.price {
	display: flex; flex-direction: column; align-items: flex-start; gap: 4px;
	margin: 0 !important; padding: 0 !important; border: none !important;
	font-family: var(--pdp-mono) !important;
}
body.product_product .product-right .product-prices .priceRef {
	font: 600 11px/1.2 var(--pdp-ui) !important; text-transform: uppercase; letter-spacing: .06em;
	color: var(--pdp-muted) !important; margin: 0 0 2px;
}
body.product_product .product-right .product-prices del,
body.product_product .product-right .product-prices .amount-before,
body.product_product .product-right .product-prices .amount-before-package {
	font: 500 15px/1.2 var(--pdp-mono) !important; color: #9396a3 !important; text-decoration: line-through;
}
body.product_product .product-right .product-prices .price-current,
body.product_product .product-right .product-prices .price-current-package,
body.product_product .product-right .product-prices .mptnew-price,
body.product_product .product-right .product-prices .mptnew-price-package {
	font: 700 clamp(26px, 2.4vw, 34px)/1.05 var(--pdp-mono) !important; color: var(--pdp-accent) !important; letter-spacing: -.01em;
}
body.product_product .product-right .product-prices .without_tax,
body.product_product .product-right .without_tax {
	font: 400 12px/1.3 var(--pdp-ui) !important; color: var(--pdp-muted) !important; margin: 4px 0 0 !important;
}
body.product_product .product-right > .without_tax { margin: 0 0 14px !important; }
body.product_product .product-right .packageRef {
	display: block; margin: 0 0 18px !important; padding: 10px 0 0 !important; text-align: center;
	font: 400 13.5px/1.4 var(--pdp-mono) !important; color: var(--pdp-ink) !important;
}

/* ---------- options --------------------------------------------------------- */
body.product_product .product-right .product-options { margin: 14px 0 4px; }
body.product_product .product-right .product-options .control-label,
body.product_product .product-right .product-options label.col-form-label {
	font: 600 12px/1.3 var(--pdp-ui) !important; text-transform: uppercase; letter-spacing: .05em; color: var(--pdp-muted) !important;
}
body.product_product .product-right .product-options select.form-control,
body.product_product .product-right .product-options input.form-control {
	height: 48px; border: 1px solid var(--pdp-line); border-radius: var(--pdp-radius-sm); box-shadow: none; font: 400 15px var(--pdp-ui);
}
body.product_product .product-right .product-option-block { border: 1px solid var(--pdp-line); border-radius: var(--pdp-radius-sm); overflow: hidden; }

/* ---------- quantity + add to cart (card CTA) ------------------------------- */
body.product_product .product-right .product-buttons {
	display: flex !important; flex-wrap: wrap; align-items: flex-end; gap: 10px; margin: 14px 0 6px !important; padding: 0 !important; border: none !important;
}
body.product_product .product-right .product-quantity { flex: 0 0 auto; margin: 0 !important; float: none; width: auto; }
body.product_product .product-right .product-quantity-label {
	font: 600 11px/1.2 var(--pdp-ui) !important; text-transform: uppercase; letter-spacing: .06em; color: var(--pdp-muted) !important; margin: 0 0 6px !important; text-align: left;
	/* the theme hangs it 30px above the spinner (absolute): with no options above it landed on the price box */
	position: static !important; top: auto !important; height: auto !important; line-height: 1.2 !important; width: auto !important;
}
body.product_product .product-right .number-spinner {
	display: flex !important; align-items: center; height: 54px; width: 140px;
	border: 1px solid var(--pdp-line); border-radius: var(--pdp-radius-sm); background: #fff; overflow: hidden;
}
body.product_product .product-right .number-spinner .input-group-btn { display: block; width: 44px; height: 100%; }
body.product_product .product-right .number-spinner .btn {
	width: 44px; height: 100%; border: none !important; background: transparent !important; box-shadow: none !important;
	font: 500 20px/1 var(--pdp-ui); color: var(--pdp-ink); border-radius: 0 !important; padding: 0;
}
body.product_product .product-right .number-spinner .btn:hover { background: var(--pdp-surface) !important; }
body.product_product .product-right .number-spinner #input-quantity {
	flex: 1 1 auto; width: 52px !important; height: 100% !important; border: none !important; box-shadow: none !important;
	font: 600 16px/1 var(--pdp-mono); color: var(--pdp-ink); background: transparent; padding: 0;
}
body.product_product .product-right .number-spinner .clearfix { display: none; }

body.product_product .product-right .product-cart { flex: 1 1 220px; margin: 0 !important; float: none; width: auto; }
body.product_product .product-right .product-cart-button {
	display: flex !important; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 54px;
	background: #111 !important; color: #fff !important; border: none !important; border-radius: var(--pdp-radius-sm) !important;
	font: 700 15px/1 var(--pdp-ui) !important; letter-spacing: .01em; box-shadow: none !important; transition: background .15s ease;
}
body.product_product .product-right .product-cart-button:hover { background: var(--pdp-accent-deep) !important; }
body.product_product .product-right #button-cart-disabled { background: #d9dbe1 !important; color: var(--pdp-muted) !important; cursor: not-allowed; }
body.product_product .product-right .product-cart-button i { font-size: 15px; }

body.product_product .product-right .product-wishlist { flex: 0 0 54px; margin: 0 !important; float: none; width: 54px; }
body.product_product .product-right .product-wishlist a {
	display: flex; align-items: center; justify-content: center; width: 54px; height: 54px; cursor: pointer;
	border: 1px solid var(--pdp-line); border-radius: var(--pdp-radius-sm); background: #fff; color: var(--pdp-ink);
}
body.product_product .product-right .product-wishlist a:hover { border-color: var(--pdp-accent); color: var(--pdp-accent); }
body.product_product .product-right .product-wishlist a span { display: none; }
body.product_product .product-right .product-wishlist i { font-size: 19px; margin: 0; }

/* ---------- benefits / filters / share --------------------------------------- */
body.product_product .product-right .product-benefits {
	margin: 18px 0 0; padding: 16px 18px; background: var(--pdp-surface); border-radius: var(--pdp-radius-sm);
	font: 400 14px/1.6 var(--pdp-ui); color: var(--pdp-ink);
}
body.product_product .product-right .product-benefits h3 { font: 700 14px/1.3 var(--pdp-ui); margin: 0 0 8px; }
body.product_product .product-right .product-filters-share { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin: 18px 0 0; padding: 16px 0 0; border-top: 1px solid var(--pdp-line); }
body.product_product .product-right .product-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
body.product_product .product-right .product-filter-block a { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border: 1px solid var(--pdp-line); border-radius: 999px; }
body.product_product .product-right .product-filter-block img { width: 26px; height: 26px; object-fit: contain; border: none !important; border-radius: 50% !important; }
body.product_product .product-right .product-filter-block h3 { font: 500 12.5px/1.2 var(--pdp-ui); margin: 0; color: var(--pdp-ink); }
body.product_product .product-right .product-share { display: flex; align-items: center; gap: 6px; margin: 0; font: 600 11px/1 var(--pdp-ui); text-transform: uppercase; letter-spacing: .06em; color: var(--pdp-muted); }
body.product_product .product-right .product-share span { margin-right: 4px; }
body.product_product .product-right .product-share a {
	display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%;
	background: var(--pdp-surface); color: var(--pdp-ink); font-size: 14px;
}
body.product_product .product-right .product-share a:hover { background: var(--pdp-accent); color: #fff; }

/* ---------- description (reading card) --------------------------------------- */
body.product_product #product .product-tabs {
	margin: 34px 0 0 !important; padding: 0; background: #fff;
	border: 1px solid var(--pdp-line); border-radius: var(--pdp-radius); overflow: hidden;
}
body.product_product #product .product-tabs .nav-tabs {
	display: flex; gap: 6px; margin: 0; padding: 18px 28px 0; border-bottom: 1px solid var(--pdp-line) !important;
}
body.product_product #product .product-tabs .nav-tabs > li { float: none; margin: 0 0 -1px; }
body.product_product #product .product-tabs .nav-tabs > li > a {
	margin: 0 !important; padding: 0 2px 14px !important; border: none !important; border-bottom: 2px solid transparent !important;
	background: none !important; font: 700 12.5px/1 var(--pdp-ui) !important; text-transform: uppercase; letter-spacing: .08em; color: var(--pdp-muted) !important;
}
body.product_product #product .product-tabs .nav-tabs > li.active > a { color: var(--pdp-ink) !important; border-bottom-color: var(--pdp-accent) !important; }
body.product_product #product .product-tabs .tab-content { padding: 30px 28px 34px !important; border: none !important; }
body.product_product #product .product-tabs .tab-pane { max-width: 820px; }

body.product_product #product .product-tabs .tab-content,
body.product_product #product .product-tabs .tab-content p,
body.product_product #product .product-tabs .tab-content li {
	font: 400 16px/1.75 var(--pdp-ui) !important; color: #2b2d33 !important;
}
body.product_product #product .product-tabs .tab-content p { margin: 0 0 14px !important; }
body.product_product #product .product-tabs .tab-content strong,
body.product_product #product .product-tabs .tab-content b { font-weight: 700; color: var(--pdp-ink); }
body.product_product #product .product-tabs .tab-content h1,
body.product_product #product .product-tabs .tab-content h2 {
	font: 700 clamp(20px, 1.8vw, 26px)/1.3 var(--pdp-ui) !important; color: var(--pdp-ink) !important; letter-spacing: -.005em;
	margin: 0 0 16px !important;
}
body.product_product #product .product-tabs .tab-content h3,
body.product_product #product .product-tabs .tab-content h4 {
	font: 700 18px/1.35 var(--pdp-ui) !important; color: var(--pdp-ink) !important;
	margin: 30px 0 12px !important; padding: 0 0 0 14px; border-left: 3px solid var(--pdp-accent);
}
body.product_product #product .product-tabs .tab-content ul { list-style: none; margin: 0 0 18px !important; padding: 0 !important; }
body.product_product #product .product-tabs .tab-content ul li { position: relative; padding: 0 0 0 22px !important; margin: 0 0 6px !important; }
body.product_product #product .product-tabs .tab-content ul li::before {
	content: ""; position: absolute; left: 4px; top: .72em; width: 7px; height: 7px; border-radius: 50%; background: var(--pdp-accent);
}
body.product_product #product .product-tabs .tab-content ol { margin: 0 0 18px; padding-left: 22px; }
body.product_product #product .product-tabs .tab-content a { color: var(--pdp-accent); text-decoration: underline; text-underline-offset: 2px; }
body.product_product #product .product-tabs .tab-content img { max-width: 100%; height: auto; border-radius: var(--pdp-radius-sm); }
body.product_product #product .product-tabs .tab-content table { width: 100%; border-collapse: collapse; margin: 0 0 18px; font-size: 15px; }
body.product_product #product .product-tabs .tab-content table td,
body.product_product #product .product-tabs .tab-content table th { border: 1px solid var(--pdp-line); padding: 10px 12px; }

@media (max-width: 767px) {
	body.product_product #product .product-tabs { margin-top: 22px !important; border-radius: 16px; }
	body.product_product #product .product-tabs .nav-tabs { padding: 14px 16px 0; }
	body.product_product #product .product-tabs .tab-content { padding: 20px 16px 24px !important; }
	body.product_product #product .product-tabs .tab-content,
	body.product_product #product .product-tabs .tab-content p,
	body.product_product #product .product-tabs .tab-content li { font-size: 15px !important; line-height: 1.7 !important; }
	body.product_product .pdp-badge { left: 24px; width: 48px; height: 48px; font-size: 13px; }
	body.product_product .product-left .thumb { grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; }
	body.product_product .product-right .product-cart { flex-basis: 160px; }
}

/* ---------- fixes after visual check ---------------------------------------- */
/* CTA = the product card button (black, accent on hover). Id selector beats the older #button-cart rule. */
body.product_product #product #button-cart.product-cart-button { background: var(--pdp-cta, #111) !important; }
body.product_product #product #button-cart.product-cart-button:hover { background: var(--pdp-accent-deep) !important; }
/* badge sits inside the photo corner */
body.product_product .pdp-badge { top: 14px; left: 14px; }

/* spacing: description paragraphs were far apart and the card had a large empty bottom */
body.product_product #product .product-tabs .tab-content { padding: 26px 28px 24px !important; }
body.product_product #product .product-tabs .tab-content p { margin: 0 0 8px !important; }
body.product_product #product .product-tabs .tab-content p:empty,
body.product_product #product .product-tabs .tab-content p:has(> br:only-child) { display: none; }
body.product_product #product .product-tabs .tab-content .tab-pane > :last-child,
body.product_product #product .product-tabs .tab-content .product_description > :last-child { margin-bottom: 0 !important; }
body.product_product #product .product-tabs .tab-content h1 + p,
body.product_product #product .product-tabs .tab-content h2 + p { margin-top: 0 !important; }

/* mobile: quantity + cart + wishlist on one row, share label on one line */
body.product_product .product-right .product-share span { white-space: nowrap; }
@media (max-width: 767px) {
	body.product_product .product-right .product-buttons { flex-wrap: nowrap; gap: 8px; }
	body.product_product .product-right .number-spinner { width: 112px; }
	body.product_product .product-right .number-spinner .input-group-btn,
	body.product_product .product-right .number-spinner .btn { width: 36px; }
	body.product_product .product-right .product-cart { flex: 1 1 0; min-width: 0; }
	body.product_product .product-right .product-cart-button { font-size: 14px !important; padding: 0 10px; }
