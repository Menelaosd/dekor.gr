<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/1999/REC-html401-19991224/strict.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>{{ title }}</title>
</head>

<body style="font-family: Open Sans, Arial, Helvetica, sans-serif; font-size: 13px; color: #000000;">
    <div style="width: 680px; margin: 0 auto;">
        <center>
            <a href="{{ store_url }}" title="{{ store_name }}" style="text-align: center;display: block;">
                <img src="{{ logo }}" alt="{{ store_name }}" style="margin:20px auto; border: none;" />
            </a>
        </center>
        <p style="border-bottom: solid 1px #ccc;padding-bottom: 10px;width: 100%;"></p>
        <p style="margin-top: 20px; margin-bottom: 20px; text-align: center">{{ footer_text }}</p>

        <p style="border-bottom: solid 1px #ccc;padding-bottom: 10px;width: 100%;"></p>
        <p style="margin-top: 20px; margin-bottom: 20px; text-align: center">{{ order_link_text }} <i><a href="{{ order_link }}">{{ order_link }}</a></i></p>
    </div>
</body>
</html>

