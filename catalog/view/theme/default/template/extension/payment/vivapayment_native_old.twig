		</div>

<script src="catalog/view/javascript/vivapayment.js" type="text/javascript"></script>
<script type="text/javascript">
        $('#button-native-payment').on('click', function(e){ 
            VivaPayments.cards.requestToken();
            //$( this ).off(e);
        });
        
		$(document).ready(function (){
			   VivaPayments.cards.setup({
					publicKey: <?php echo "'".$vivapayment_publickey."'"; ?>,
					baseURL: 'https://demo.vivapayments.com',
					cardTokenHandler: function (response) {
							if (!response.Error) {
							     $('#button-native-payment').attr('disabled', true);
			                     $('#button-native-payment').after('<span class="wait">&nbsp;<img src="catalog/view/theme/default/image/loading.gif" alt="" /></span>');
							     $('#hidToken').val(response.Token);
                                if (response.Token !=''){
                                    var amount = <?php echo $amount; ?>;
                                    var installments = $('#drpInstallments').val();
                                    var orderId = <?php echo $orderid; ?>;
                                    $.ajax({
                                        url:'index.php?route=payment/vivapayment/makePayment',
                                        type: 'POST',
                                        data: 'hidToken=' + encodeURIComponent(response.Token) +'&installments=' + installments + '&amount='+amount+'&orderid='+orderId,
                                        dataType: 'json',
                                        success: function(json) {
                                            if (json['error']){
                                                alert('Error Code: ' + json['error']);
                                                $('.wait').remove();
                                                $('#button-native-payment').attr('disabled', false);
                                                //location = json['failure'];
                                            } else {
                                                location = json['success'];
                                            }
                                        },
                                        error: function(xhr, ajaxOptions, thrownError) {
                                            
                    						alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                                            return false;
                    					}
                                    });
                                    
                                    
     			                    //$('#button-native-payment').attr('disabled', false);
                                    //$('.wait').remove();
                                }
								//$('#payment-form').submit();
								return false;
							}
							else{
								console.log(response);
								alert(response.Error);
								return false;
							}
					},
					installmentsHandler: function (response) {
					       var indata = <?php echo "'".$indata['arithmos_doseon']."'"; ?>;
                           var inallow = <?php echo "'".$inallow."'"; ?>;
							if (!response.Error) {
									if (indata == 0 || inallow == 1)
										return;
                                        
                                        
									$('#drpInstallments').show();
									for(i=1; i<=indata; i++){
										$('#drpInstallments').append($("<option>").val(i).text(i));
									}
							}
							else
								alert(response.Error);
					}
			   });
		});
</script>