<div class="container">
	<nav id="hol_menu" class="navbar navbar-default">
	    <div class="navbar-header"><span id="category" class="visible-xs">{{ text_category }}</span>
			<button type="button" class="btn btn-navbar navbar-toggle" data-toggle="collapse" data-target=".navbar-ex1-collapse"><i class="fa fa-bars"></i></button>
	    </div>
	    <div class="collapse navbar-collapse navbar-ex1-collapse">
			<ul class="nav navbar-nav">
				{% for nav_item in nav %}
					{% if nav_item.children %}
						<li class="dropdown">
							<a href="{{ nav_item.url }}" class="dropdown-toggle" data-toggle="dropdown">{{ nav_item.title }} <span class="caret"></span></a>
							<ul class="dropdown-menu">
								{% for child in nav_item.children %}
									{% if child.children %}
										<li class="dropdown-submenu">
											<a  tabindex="-1" href="{{ child.url }}">{{ child.title }}</a>
											<ul class="dropdown-menu">
												{% for childer in child.children %}
													<li><a href="{{ childer.url }}">{{ childer.title }}</a></li>
												{% endfor %}
											</ul>
									{% else %}
										<li><a href="{{ child.url }}">{{ child.title }}</a></li>
									{% endif %}
								{% endfor %}
							</ul>
						</li>
					{% else %}
						<li><a href="{{ nav_item.url }}">{{ nav_item.title }}</a></li>
					{% endif %}
				{% endfor %}
			</ul>
		</div>
	</nav>
</div>