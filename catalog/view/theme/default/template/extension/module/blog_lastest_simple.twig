<div class="simple-blog-module">
    <h3 class="simple-blog-title">{{ heading_title_latest }}</h3>
    <div class="simple-blog-description">
        {{ text_descreption }}
        <a class="simple-blog-show-all" href="{{ blog_show_all }}">{{ text_show_all }}</a>
    </div>

    <div class="simple-blog-list">
        {% for blog in posts %}
            <div class="simple-blog-item">
                {% if blog.image and thumb %}
                    <div class="simple-blog-image">
                        <a href="{{ blog.href }}">
                            <img src="{{ blog.image }}" alt="{{ blog.title }}" title="{{ blog.title }}"
                                 rel="preload" fetchpriority="high" decoding="async" loading="lazy"
                                 width="350" height="350"/>
                        </a>
                    </div>
                {% endif %}
                <div class="simple-blog-content">
                    <h4 class="simple-blog-post-title">
                        <a href="{{ blog.href }}">{{ blog.title }}</a>
                    </h4>
                    {% if date_added_status %}
                        <span class="simple-blog-date">{{ blog.date_added_full }}</span>
                    {% endif %}
                    {% if not characters == '0' %}
                        <p class="simple-blog-excerpt">{{ blog.description }}</p>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
