{{ header }}
<div id="product-manufacturer" class="container">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"{% if loop.last %} aria-current="page"{% endif %}><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ol>
  </nav>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-12 col-lg-6' %}
    {% elseif column_left or column_right %}
	{% set productclass = 'col-12 col-sm-4' %}
    {% set class = 'col-12 col-lg-9' %}
    {% else %}
	{% set productclass = 'col-12 col-lg-3 col-sm-4' %}
    {% set class = 'col-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if products %}
      <div class="row">
        <div class="col-12">
		  <div class="top-toolbar">
			  <div class="top-toolbar-forms">
				  <div class="form-group input-group input-group-sm">
					<label class="input-group-prepend" for="input-sort"><span>{{ text_sort }}</span></label>
					<select id="input-sort" class="form-control">
					  {% for sorts in sorts %}
					  {% if sorts.value == '%s-%s'|format(sort, order) %}
					  <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
					  {% else %}
					  <option value="{{ sorts.href }}">{{ sorts.text }}</option>
					  {% endif %}
					  {% endfor %}
					</select>
				  </div>
				  <div class="form-group input-group input-group-sm">
					<label class="input-group-prepend" for="input-limit"><span>{{ text_limit }}</span></label>
					<select id="input-limit" class="form-control">
					  {% for limits in limits %}
					  {% if limits.value == limit %}
					  <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
					  {% else %}
					  <option value="{{ limits.href }}">{{ limits.text }}</option>
					  {% endif %}
					  {% endfor %}
					</select>
				  </div>
			  </div>
			  <div id="pagination-top">
				  <div class="pagination-page-container">
					{{ pagination }}
				  </div>
			  </div>
			  {# <div class="btn-group btn-group-sm">
				<button type="button" id="list-view" class="btn btn-light border" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
				<button type="button" id="grid-view" class="btn btn-light border" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
			  </div> #}
		  </div>
        </div>
      </div>
      <div id="product-container" class="row"> 
	    {% for product in products %}
        <div class="product-layout product-grid {{productclass}}">
			{{ include('hotheme/template/product/product_template/product_main.twig') }}
        </div>
        {% endfor %} 
	  </div>
      <div id="pagination"  class="pagination-page-container">{{ pagination }}</div>
      {% endif %}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}