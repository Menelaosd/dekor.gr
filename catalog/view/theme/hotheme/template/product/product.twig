			<div class="modal-header flat">
				<h4 class="modal-title" id="myModalLabel">ΛΙΣΤΑ ΕΙΔΟΠΟΙΗΣΕΩΝ ΔΙΑΘΕΣΙΜΟΤΗΤΑΣ</h4>
			</div>
			<div class="modal-body modal-body-notify flat">
				<div class="row">
					<div class="col-sm-6 col-md-4 col-12">
						<div class="notify-form-image">
							<img class="modal-thumb img-responsive hidden-xs" src="{{ thumb }}" alt="thumb" />
						</div>
					</div>
					<div class="col-sm-6 col-md-8 col-12">
						<div class="modal-p-title flat">
							{{ heading_title }}
						</div>
						<div class="modal-p-model flat">
							<span class="label_d">{{ text_model }}</span> {{ model }}
						</div>
						<div class="modal-p-desc flat">
							Δώσε μας τα στοιχεία σου και θα σε ειδοποιήσουμε όταν το προϊόν είναι πάλι διαθέσιμο!
						</div>
						<form id="reminderForm">
							<div class="reminderRow">
								<input id="modal_name" type="text" placeholder="Όνομα *" value="" name="modal_name">
							</div>
							<div class="reminderRow">
								<input id="modal_surname" type="text" placeholder="Επώνυμο *" value="" name="modal_surname">
							</div>
							<div class="reminderRow">
								<input id="modal_email" type="text" placeholder="Email *" value="" name="modal_email">
							</div>
							<div class="reminderRow">
								<input id="modal_phone" type="text" placeholder="Τηλέφωνο *" value="" name="modal_phone">
							</div>
							<input id="modal_product_id" type="hidden" value="{{ product_id }}" name="modal_product_id">
							<input id="modal_size_id" type="hidden" value="{{ model }}" name="modal_size_id">
							<input id="csrf-token" type="hidden" value="{{ token }}" name="csrf-token">
						</form>
					</div>
				</div>
			</div>
			<div class="modal-footer flat">
				<a href="javascript:void(0);" class="btn btn-default" id="close-modal-av" data-dismiss="modal"><i class="far fa-times"></i>ΚΛΕΙΣΙΜΟ</a>
				<a href="javascript:void(0);" id="reminder_send" class="btn btn-primary"><i class="fal fa-bells"></i> ΕΙΔΟΠΟΙΗΣΕ ΜΕ</a>
			</div>
		</div>
	</div>
</div>

<script type="text/javascript">

	$(document).ready(function(){
		$('body').on('click','#button-reminder',function(){
			setTimeout(function(){
				$('#reminderModal').modal('show');
			}, 500);
		});
	});

	$('#reminder_send').on('click', function() {
		$.ajax({
			url: 'index.php?route=product/product/addreminder',
			type: 'post',
			data: $('#modal_name, #modal_surname, #modal_email, #modal_phone,#modal_product_id,#csrf-token'),
			dataType: 'json',
			beforeSend: function() {
				$('#reminder_send').button('ΦΟΡΤΩΣΗ');
			},
			complete: function() {
				$('#reminder_send').button('reset');
			},
			success: function(json) {
				$('.alert, .text-danger').remove();
				$('.reminderRow').removeClass('has-error');

				if (json['error']) {
					if (json['error']['modal_name']) {
						$('#modal_name').parent().append('<div class="text-danger">' + json['error']['modal_name'] + '</div>');
					}
					if (json['error']['modal_surname']) {
						$('#modal_surname').parent().append('<div class="text-danger">' + json['error']['modal_surname'] + '</div>');
					}
					if (json['error']['modal_email']) {
						$('#modal_email').parent().append('<div class="text-danger">' + json['error']['modal_email'] + '</div>');
					}
					if (json['error']['modal_phone']) {
						$('#modal_phone').parent().append('<div class="text-danger">' + json['error']['modal_phone'] + '</div>');
					}

					// Highlight any found errors
					$('.text-danger').parent().addClass('has-error');
				}
				
				if (json['success']) {
					$('#reminderForm')[0].reset();
					$('#reminderModal').modal('toggle');
					$('.breadcrumb').after('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + '<button type="button" class="close" data-dismiss="alert">×</button></div>');
					
					$('html, body').animate({ scrollTop: 0 }, 'fast');
				}
				if (json['fail_token']) {
					$('#reminderForm').prepend('<div class="text-danger">' + json['fail_token'] + '</div>');
				}				
			},
			error: function(xhr, ajaxOptions, thrownError) {
				alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
			}
		});
	});

</script>
{% endif %}

