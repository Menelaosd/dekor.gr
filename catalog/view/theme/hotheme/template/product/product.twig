						</label>
						<div class="row option-row">
						{% for optionproduct in optionsproduct %}
								<div class="form-check" >
									<div class="product-option-block">
										<a href="{{optionproduct.href}}" title="{{optionproduct.title}}">
											<div class="product-option-image">
												<img src="{{optionproduct.image}}" alt="{{optionproduct.title}}" />
												<h4 class="product-option-title">{{optionproduct.title}}</h4>
											</div>
											{# <div class="product-option-caption">
												<h4 class="product-option-title">{{optionproduct.title}}</h4>
											</div> #}
										</a>
									</div>
								</div>
						{% endfor %}
						</div>
					</div>
