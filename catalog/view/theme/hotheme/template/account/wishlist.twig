{{ header }}
<div id="account-wishlist" class="container">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"{% if loop.last %} aria-current="page"{% endif %}><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ol>
  </nav>
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">
    <div id="content" class="col-12">{{ content_top }}
      <h1>{{ heading_title }}</h1>
      {% if products %}
		  <div class="account-wish-container">
			  <div id="product-container" class="product-container row">
				{% for product in products %}
					<div class="product-layout product-grid col-lg-3 col-sm-6">
						<a href="{{ product.remove }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-remove-product"><i class="fas fa-times"></i></a>
						{{ include('hotheme/template/product/product_template/product_main.twig') }}
					</div>
				{% endfor %} 
			  </div>
      {% else %}
	 
      <p>{{ text_empty }}</p>
      {% endif %}
      {{ content_bottom }}</div>
    </div>
</div>
{{ footer }}