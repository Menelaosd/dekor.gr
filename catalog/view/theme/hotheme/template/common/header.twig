<div class="wrapper">
<header id="header">
	{% if (config_ex_phone_order) or (config_ex_address) or (config_social_text) or (config_ex_custom_text_title) %}
		{% if not mobile %}
			<div class="header-top-bar d-none d-lg-block">
				<div class="container">
					<div class="row">
						<div class="header-top-bar-block-1 header-top-bar-block col-sm-6 col-12">
							{% if (config_ex_custom_text_title) %}
								<span>{{ config_ex_custom_text_title }}</span>
							{% endif %}
							{# {% if (config_ex_phone_order) %}
								<span><i class="fal fa-phone-volume"></i>{% if (config_ex_phone_order_label) %}<span class="header-order-label">{{ config_ex_phone_order_label }}:</span>{% endif %} {% if (config_ex_phone_order) %}<span class="header-order-phone"> {{ config_ex_phone_order }}</span>{% endif %}</span>
							{% endif %}
							{% if (config_ex_address) %}
								<span><i class="fal fa-map-marker-alt"></i>{{ config_ex_address }}</span>
							{% endif %} #}
						</div>
						<div class="header-top-bar-block-2 header-top-bar-block col-sm-6 col-12">
						
							{% if currency_counter > 1 %}
								<div class="header-main-block-currency currency-icon header-main-block-icon">
									{{ currency }}
								</div>
							{% endif %}
							{% if language_counter > 1 %}
								<div class="header-main-block-language language-icon header-main-block-icon">
									{{ language }}
								</div>
							{% endif %}
							
							{# {% if (config_ex_custom_text_title) %}
								<a href="{{config_ex_custom_text_url}}" target="_blank" class="blink_me"><span>{{ config_ex_custom_text_title }}</span></a>
							{% endif %}
							{% if (config_social_text) %}
								<span>{{ config_social_text }}</span>
								<span>
								{% if (config_facebook) %}
									<a href='{{config_facebook}}'><i class='fab fa-facebook-f'></i></a>
								{% endif %}
								{% if (config_twitter) %}
									<a href='{{config_twitter}}'><i class='fab fa-twitter'></i></a>
								{% endif %}
								{% if (config_instagram) %}
									<a href='{{config_instagram}}'><i class='fab fa-instagram'></i></a>
								{% endif %}
								{% if (config_youtube) %}
									<a href='{{config_youtube}}'><i class='fab fa-youtube'></i></a>
								{% endif %}
								</span> 
							{% endif %} #}
						</div>	
					</div>
				</div> 
			</div>
		{% endif %}
	{% endif %}
	<div class="header-main"> 
		<div class="container">
			<div class="row">
				<div class="header-main-wrapper">
					<div class="header-main-block-2 header-main-block header-main-block-left col-sm-5 col-12">
						<a id="desktop_menu_expand">
							<i class="far fa-bars"></i>
							<span>{{ text_menu }}</span>
						</a>
						<div class="top-menu">
						
							{#
							<a href="{{ ideas_link }}" title="{{ text_menu_idea }}">
							{{ text_menu_idea }}
							</a>
							#}		
							<a href="#product-bundles-swiper0" title="{{ text_menu_idea }}">
							{{ text_menu_idea }}
							</a>
							
							
							<a href="#diy-wrapper0" title="{{ text_menu_diy }}">
								{{ text_menu_diy }}
							</a>	
							
							{#
							<a href="{{ videos_link }}" title="{{ text_menu_diy }}">
								{{ text_menu_diy }}
							</a>
							#}
							
							{# <a href="{{ text_menu_shoplook_link }}">{{ text_menu_shoplook }}</a> #}
							<a href="{{ stores_link }}">{{ text_menu_stores }}</a>
						</div>
					</div>
					<div class="header-main-block-1 header-main-block header-logo col-sm-2 col-12">
						<div id="logo">
							{% if logo %}
								<a href="{{ home }}">
									<img src="{{ desktop_logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid" />
								</a>
							{% else %}
								<h1><a href="{{ home }}">{{ name }}</a></h1>
							{% endif %} 
						</div>
					</div>
					
					<div class="header-main-block-3 header-main-block header-main-block-right header-utilities col-sm-5 col-12">
						
						{% if not mobile %}
							<div class="header-main-block-search">
								{{ search }}
							</div>
						{% endif %}
						
						<div class="header-tools">
						
							<div class="header-langs">
								<div class="language-switcher">
									<img src="https://flagcdn.com/w40/gr.png" class="language-flag" onclick="changeLang('el')" alt="Greek">
									<img src="https://flagcdn.com/w40/gb.png" class="language-flag" onclick="changeLang('en')" alt="English">
									<img src="https://flagcdn.com/w40/bg.png" class="language-flag" onclick="changeLang('bg')" alt="Bulgarian">
								</div>

								<div id="google_translate_element"></div>
							</div>
						
							<div id="user" class="header-main-block-user header-main-block-icon">
								<a href="{{ account }}" title="{{ text_account }}">
									{# <i class="fal fa-user"></i> #}
									<i class="fal fa-user-circle"></i>
								</a>
							</div>
							<div id="wish" class="header-main-block-wish header-main-block-icon">
							
								<a href="{{ wishlist }}" >
									<i class="fal fa-heart"></i>
									<span data-has-total="{{wish_total}}" class="ho-total-counter wish-total">{{wish_total}}</span>
								</a>
								
							</div>
							<div class="header-main-block-cart cart-icon header-main-block-icon">
								<a data-loading-text="{{ text_loading }}" class="menu-cart-icon" href="{{ shopping_cart }}">
									<i class="fal fa-shopping-bag"></i> 
									<span data-has-total="{{text_count_items}}" class="ho-total-counter cart-total" id="cart-total">{{ text_count_items }}</span> 
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div id="desktop-menu-vertical" class="">
		<a href="#" class="close-menuNav" title="{{ text_close_menu }}"><i class="fal fa-times"></i></a>
		<div class="desktop-menu-container">
			{% if not mobile %}
				{{ menu }}	
			{% endif %}
		</div>
	</div>
</header>


<div id="mobile-header" class="d-lg-none d-xl-none">		
	<div class="mobile--header__left">
		<a href="#mmenu" class="header-toggle-icon mobile--header__icon" title="Menu">
			<i class="fas fa-bars"></i>
		</a>
		<a href="#" class="d-xl-none trigger-search header-main-block-icon search-icon-mobile mobile--header__icon" title="{{ text_search }}">
			<i class="fal fa-search"></i>
		</a>					
	</div>
	
	<div class="mobile--header__logo">
		<a href="{{ home }}" title="Gini">
			<img srcset="{{ logo }} 1x, {{ logo }} 2x" src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid" />
		</a>			
	</div>
	
	<div class="mobile--header__right">
	
		<a href="{{ account }}"  class="header-account-icon" title="{{ text_account }}">
			<i class="fal fa-user-circle"></i>
			{{ menu_account }}
		</a>
		
		{% if language_counter > 1 %}
			<div class="header-main-block-language language-icon header-main-block-icon mobile--header__icon">
				{{ language }}
			</div>
		{% endif %}		
	
		<div class="header-main-block-cart cart-icon header-main-block-icon">
			<a data-loading-text="{{ text_loading }}" class="mobile--header__icon" href="{{ shopping_cart }}" title="{{ text_my_cart }}">
				<i class="fal fa-shopping-bag"></i> 
				<span data-has-total="{{text_count_items}}" class="ho-total-counter cart-total" id="cart-total">{{ text_count_items }}</span> 
			</a>
		</div>
				
	</div>	
	
	{% if mobile %}
		<div id="header-bottom" class="container" style='display:none;'>
			<div id="header-search-container">
				{{ search }}
			</div>
		</div>
	{% endif %}
	
</div>	

{{cart}}

{% if mobile %}
<div style="display:none">
	{{ mmenu }}
</div>
{% endif %}


{% if mobile %}
<script>

	var mmenu = $("#mmenu").mmenu({	
		"extensions": [
			"pagedim-black"
		],
		
	   "navbars": [
	   ],		
		dropdown: {
			position: "#mobile-header",
		width: {
			max: 992
			}
		},		   
		"autoHeight": false,
		"slidingSubmenus": false
	}).data('mmenu');
	
	$("#closeMMENU").click(function(e) {
		e.preventDefault();
		mmenu.close();
	});	

