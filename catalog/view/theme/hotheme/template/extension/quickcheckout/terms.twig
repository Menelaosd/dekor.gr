
<div id="payment" class="text-left" style="display:none;"></div>
<div class="terms">
{% if text_agree %}
    <div class="checkbox-group">
		<input id="agree" type="checkbox" name="agree" value="1" />
		<label for="agree">{{ text_agree }}</label>
	</div>
  {% endif %}
  
	<div class="checkbox-group">
		<input type="checkbox" name="newsletter" checked="checked" value="1" id="newsletter"/>
		<label for="newsletter">{{ text_newsletter }}</label>
	</div>
  
  <button type="button" id="button-payment-method" class="btn btn-primary" data-loading-text="{{ text_loading }}">{{ text_submit }}<i class="fas fa-check-circle"></i></button>
</div>