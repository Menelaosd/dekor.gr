					  <input type="checkbox" name="create_account" value="1" id="create" class="hide" checked="checked" />
					{% else %}
						<div class="checkbox-group">
							<input type="checkbox" name="create_account" value="1" id="create"{{ create_account ? ' checked="checked"' }} />
							<label for="create">{{ text_create_account }}</label>	
						</div>
					{% endif %} 
					<div id="create_account">{{ register }}</div>
				  {% else %}
					<input type="checkbox" name="create_account" value="1" id="create" class="hide" />
				  {% endif %}
				</div>

			{% endif %}
		 
			
			{# 
			{% if quickcheckout_layout == '2' %} 
			<div class="quickcheckoutright">
			  {% if voucher_module or coupon_module or reward_module %} 
			  <div id="voucher">
				<div class="quickcheckout-content">{{ voucher }}</div>
			  </div>
			  {% endif %}
			</div>
			{% elseif quickcheckout_layout == '1' or quickcheckout_layout == '3' %}
			{% if cart_module or voucher_module or coupon_module or reward_module %}
			<div class="quickcheckoutleft extra-width">
			  {% if voucher_module or coupon_module or reward_module %}
			  <div id="voucher">
				<div class="quickcheckout-content" style="border:none; padding: 0px;overflow: hidden;">{{ voucher }}</div>
			  </div>
			  {% endif %}
			</div>
			{% endif %} 
			{% endif %}	
			#}
		  
		  <div class="quickcheckoutleft">
			<div id="payment-address">
				<form>
			  		<div class="quickcheckout-content">{{ guest ? guest : payment_address }}</div>
					{% if logged and not addresses %} 
						<div class="select-shipping">
						  {% if shipping_required %} 
							<div class="checkbox-group">
								<input type="checkbox" name="shipping_address" value="1" id="shipping"{{ shipping_address ? ' checked="checked"' }} />
								<label for="shipping">{{ entry_shipping }}</label>
							</div>
						  {% else %}   
							<input type="checkbox" name="shipping_address" value="1" id="shipping" checked="checked" class="hide" />
						  {% endif %}
						</div>
					{% endif %} 
				</form>
			</div>
			
			
			
			{% if shipping_required %} 
			<div id="shipping-address">
				<form>
			  		<div class="quickcheckout-heading"><i class="fa fa-user"></i> {{ text_checkout_shipping_address }}</div>
			  		<div class="quickcheckout-content">{{ shipping_address ? shipping_address }}</div>
				</form>
			</div>
			{% endif %} 
		  </div>


			<div class="cart-methods">

				{% if shipping_required %} 
				<div id="shipping-method"{{ not shipping_module ? ' style="display:none;"' }}>
				  <div class="quickcheckout-heading"><i class="fa fa-truck"></i> {{ text_checkout_shipping_method }}</div>
				  <div class="quickcheckout-content"></div>
				</div>
				{% endif %}
				
				
				<div id="payment-method"{{ not payment_module ? ' style="display:none;"' }}>
				  <div class="quickcheckout-content"></div>
				</div>	

			</div>
		  
		{% if store_info %}
		<div id="storeinfo">
			<h4>{{ store_info.title }}</h4>
			<div class="storeinfo-wrap">
				{{ store_info.description }}
			</div>
		</div>
		{% endif %}
		{% if field_comment.display %} 
		<div class="comments-wrapper">
			<label for="comment">{% if field_comment.required %}<span class="required">*</span> {% endif %}{{ text_comments }}</label>
			<textarea name="comment" id="comment_checkout" rows="8" class="form-control" placeholder="{{ field_comment.placeholder ? field_comment.placeholder }}">{{ comment ? comment : field_comment.default }}</textarea>
		</div>
		{% else %}
			<div class="comments-area">
				<label for="comment">{{ text_comments }}</label>
				<textarea name="comment" id="comment_checkout class="hide"></textarea>
			</div>
		{% endif %}		
		 {# 
		 <div class="quickcheckout-content delivery-message">
		  <p>Ευχαριστούμε για την προτίμησή σας!</p>
		  <p><b>Σας ενημερώνουμε, ότι λόγω του τεράστιου όγκου παραγγελιών που δέχονται αυτή την περίοδο οι εταιρίες ταχυμεταφορών (courier), παρατηρούνται καθυστερήσεις στις παραδόσεις.</b></p>
		  <p>Καταβάλλεται κάθε δυνατή προσπάθεια για τη μείωση του χρόνου παράδοσης.</p>
		  <p>Σας ευχαριστούμε για την κατανόηση.</p>
		  </div>
		  <style>
			.delivery-message {
			-webkit-box-shadow: 0 2px 15px rgba(0, 0, 0, .1);
			-moz-box-shadow: 0 2px 15px rgba(0, 0, 0, .1);
			box-shadow: 0 2px 15px rgba(0, 0, 0, .1);
			padding: var(--space) var(--space-double);
			border-radius: 5px;
			margin-bottom: var(--space);
			}
		  </style> #} 
		  <div style="clear: both;"></div>
		</div><!-- Close Quick Checkout Disable Div -->
		<div id="paymentinstructions"></div>
		<div class="quickcheckoutmid">
		  <div id="terms">
			<div class="quickcheckout-content-confirm">
				{{ terms }}
			</div>
		  </div>
		</div>
	  </div><!-- Close QuickCheckoutConfirm div -->

	  {% if html_footer %}
	  {{ html_footer }}
	  {% endif %}
	  <!-- End -->
	{{ content_bottom }}
	</div>
	</div>
	
	{% if steps != 1 %}
	
	<aside class="checkout-sidebar-right">
	  {% if cart_module %} 
	  <div id="cart1">
		<div class="quickcheckout-content" style="border:none; padding: 0px;"></div>
	  </div>
	  {% endif %}
	</aside>
	
	{% endif %}
	
  </div>
</div>


