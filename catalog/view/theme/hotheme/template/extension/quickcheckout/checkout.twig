			{% else %}   
				$('#terms .terms').hide();
				$('#payment').html(html).slideDown('fast');
				
				{% if auto_submit %} 
				$('#payment').hide().after('<div class="text-center cartloading"><i class="fa fa-spinner fa-spin fa-5x"></i></div>');
