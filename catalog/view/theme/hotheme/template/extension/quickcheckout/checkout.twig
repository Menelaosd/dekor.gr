{% if getcart %}
	<div id="payment-address">
		<form>
			<div class="quickcheckout-content">{{ guest ? guest : payment_address }}</div>
		</form>
	</div>
{% else %}

{{ header }}

{% set guestClass = 'user-wrapper' %}
{% if not logged %} 
	{% set guestClass = 'guest-wrapper' %}
{% endif %}

<div id="checkout-checkout" class="container {{ guestClass }}">


  {% if steps == 1 %}
  <div class="checkout-account-block">
			
		<h1 class="cart-page-title"> {{ heading_title }} </h1>
	  
		<div class="chekout-main-container">
			<div class="chekout-main-container-inner">
				
				<div class="steps-container login-container">
				
					<div id="login-warning-messages"></div>
				
					<div class="checkout-main-title-wrapper">
						<h3 class="main-title">{{ text_login_heading }}</h3>
					</div>
					
					<div class="quickcheckoutmid" id="login-box">
						<div id="checkout">
							<div class="quickcheckout-content">{{ login }}</div>
						</div>
					</div>
					
				</div>
				
				<div class="div-or">{{ text_or }}</div>
				
				<div class="steps-container register-container">
					<div class="checkout-main-title-wrapper">
						<h3 class="main-title">{{ text_register_heading }}</h3>
						<a href="index.php?route=account/register" class="btn btn-primary">{{ text_register }}</a>
						{#
						<div class="register_text">
							{{ text_register_text }}
						</div>
						#}
					</div>	
				</div>
				
				<div class="div-or">{{ text_or }}</div>
				
				<div class="steps-container guest-container">
					<div class="checkout-main-title-wrapper">
						<h3 class="main-title">{{ text_guest_heading }}</h3>
						<a href="{{guest_link}}" class="btn btn-primary">{{ text_guest_button }} <i class="fas fa-chevron-right"></i></a>
					</div>	
				</div>
				
			</div>
		</div>
		  
  </div>
  {% endif %}

  <div  class="{% if steps==1 or steps==3 %}d-none{% endif %} row checkout-row-wrapper">
	
	<aside class="checkout-sidebar-left">
		<div class="checkout-sidebar-wrapper">
			<h1 class="cart-page-title"> {{ heading_title }} </h1>
		</div>
	</aside>

	<div class="checkout-double-container">
    <div class="checkout-main">
	  <div id="warning-messages"></div>
	  <div id="success-messages"></div>

	  <div id="quickcheckout-countdown"></div>

	  <div id="quickcheckoutconfirm">
		<div id="quickcheckout-disable">
