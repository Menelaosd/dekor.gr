				$('#shipping-address #input-shipping-company').val($('#payment-address #input-payment-company').val());
				$('#shipping-address #input-shipping-address-1').val($('#payment-address #input-payment-address-1').val());
				$('#shipping-address #input-shipping-address-2').val($('#payment-address #input-payment-address-2').val());
				$('#shipping-address #input-shipping-country').val($('#payment-address #input-payment-country').val());
				$('#shipping-address #input-shipping-city').val($('#payment-address #input-payment-city').val());
				$('#shipping-address').find('#input-shipping-zone').val($('#payment-address #input-payment-zone').val());
				$('#shipping-address #input-shipping-postcode').val($('#payment-address #input-payment-postcode').val());
				$('#shipping-address').slideUp('fast');
			} else {
				$('#shipping-address').slideDown('fast');
			}
		});
		
		$(window).load(function(){
			if ($('#payment-address input[name=\'shipping_address\']:checked').val()) {
				//$('#shipping-address .quickcheckout-content').html('');
				$('#shipping-address #input-shipping-firstname').val($('#payment-address #input-payment-firstname').val());
				$('#shipping-address #input-shipping-lastname').val($('#payment-address #input-payment-lastname').val());
				$('#shipping-address #input-shipping-company').val($('#payment-address #input-payment-company').val());
				$('#shipping-address #input-shipping-address-1').val($('#payment-address #input-payment-address-1').val());
				$('#shipping-address #input-shipping-address-2').val($('#payment-address #input-payment-address-2').val());
				$('#shipping-address #input-shipping-country').val($('#payment-address #input-payment-country').val());
				$('#shipping-address #input-shipping-city').val($('#payment-address #input-payment-city').val());
				$('#shipping-address').find('#input-shipping-zone').val($('#payment-address #input-payment-zone').val());
				$('#shipping-address #input-shipping-postcode').val($('#payment-address #input-payment-postcode').val());
				$('#shipping-address').hide();
			};
		});
		
		$( document ).ajaxComplete(function() {
			if ($('#payment-address input[name=\'shipping_address\']:checked').val()) {
				//$('#shipping-address .quickcheckout-content').html('');
				$('#shipping-address #input-shipping-firstname').val($('#payment-address #input-payment-firstname').val());
				$('#shipping-address #input-shipping-lastname').val($('#payment-address #input-payment-lastname').val());
				$('#shipping-address #input-shipping-company').val($('#payment-address #input-payment-company').val());
				$('#shipping-address #input-shipping-address-1').val($('#payment-address #input-payment-address-1').val());
				$('#shipping-address #input-shipping-address-2').val($('#payment-address #input-payment-address-2').val());
				$('#shipping-address #input-shipping-country').val($('#payment-address #input-payment-country').val());
				$('#shipping-address #input-shipping-city').val($('#payment-address #input-payment-city').val());
				$('#shipping-address').find('#input-shipping-zone').val($('#payment-address #input-payment-zone').val());
				$('#shipping-address #input-shipping-postcode').val($('#payment-address #input-payment-postcode').val());
				$('#shipping-address').hide();
			};
		});
		
		{% if shipping_address %} 
		$('#shipping-address').hide();
		{% else %}   
		$('#payment-address input[name=\'shipping_address\']').trigger('change');
		{% endif %} 
	{% endif %}


	</script>
