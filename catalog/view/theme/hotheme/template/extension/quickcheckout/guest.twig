{% for field in fields %} 

  {% if field == 'customer_group' %} 
    {% if attribute(_context, 'field_' ~ field).display %}  
	<div class="required"{{ customer_groups|length <= 1 ? ' style="display:none !important"' }}>
		
		<div class="select-account-type">
			<div class="quickcheckout-heading"><i class="fas fa-file-alt"></i> {{ text_vat_fields }}</div>
			
			<div class="quickcheckout-content" id="input-payment-customer-group_id">
			{% for customer_group in customer_groups %} 
				<div class="shipping-method-block">
					<input type="radio" value="{{ customer_group.customer_group_id }}" name="customer_group_id" id="customer_group_id{{ customer_group.customer_group_id }}" 
					{#
					{% if customer_group.customer_group_id == 2 %}
						checked="checked"
					{% endif %}
					#}
					>
					<label for="customer_group_id{{ customer_group.customer_group_id }}">{{ customer_group.name }}</label>
				</div>
			{% endfor %} 
			</div>
			
		</div>
	 	  
	</div>
	{% else %}   
	  <select name="customer_group_id" class="hide">
		{% for customer_group in customer_groups %} 
		<option value="{{ customer_group.customer_group_id }}"{{ customer_group.customer_group_id == customer_group_id ? ' selected="selected"' }}>{{ customer_group.name }}</option>
		{% endfor %} 
	  </select>
	{% endif %}
  {% endif %}  
  
{% endfor %}

<h4 id="text_order_where" class="section-title">{{ text_order_where }}</h4>

<div class="row row-fields">
{% for field in fields %} 
	{% set removeClass = '' %}
	{% if attribute(_context, 'field_' ~ field).hide_field %} 
		{% if attribute(_context, 'field_' ~ field).required or field == 'postcode' %} 
			{% set removeClass = 'removeFieldRequired' %}
		{% else %}
			{% set removeClass = 'removeField' %}
		{% endif %}
	{% endif %}
  {% if field == 'country' %}	
    {% if attribute(_context, 'field_' ~ field).display %}  
	<div class="col-sm-6 {{ field }} {{ attribute(_context, 'field_' ~ field).required ? ' required' }} {{ removeClass }}">
	  <label class="control-label">{{ entry_country }}</label>
	  <select name="country_id" class="form-control" id="input-payment-country">
	  {% for country in countries %} 
		{% if country.country_id == country_id %} 
		<option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
		{% else %}   
		<option value="{{ country.country_id }}">{{ country.name }}</option>
		{% endif %}
	  {% endfor %}
	  </select>
	</div>
	{% else %}   
	<select name="country_id" class="hide">
	{% for country in countries %} 
	  {% if country.country_id == country_id %} 
	  <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
	  {% else %}   
	  <option value="{{ country.country_id }}">{{ country.name }}</option>
	  {% endif %}
	{% endfor %}
	</select>
	{% endif %}
  {% elseif  field == 'zone' %} 
    {% if attribute(_context, 'field_' ~ field).display %}  
	<div class="col-sm-6 {{ field }} {{ attribute(_context, 'field_' ~ field).required ? ' required' }} {{ removeClass }}">
	  <label class="control-label">{{ entry_zone }}</label>
	  <select name="zone_id" class="form-control" id="input-payment-zone"></select>
	</div>
	{% else %}   
	  <select name="zone_id" class="hide"></select>
	{% endif %} 
  {% elseif  field == 'email' %} 
	<input type="text" name="email" id="input-email-dummy" readonly value="" class="hide" />
  {% elseif field == 'customer_group' %} 
  {% else %}   
    {% if attribute(_context, 'field_' ~ field).display %}  
	<div{{ field == 'postcode' ? ' id="payment-postcode-required"' }} class="col-sm-6 {{ field }} {{attribute(_context, 'field_' ~ field).required ? ' required' }} {{ removeClass }}">
	  <label class="control-label" for="input-payment-{{ field|replace({'_' : '-'}) }}">{{ attribute(_context, 'entry_' ~ field) }} {% if not attribute(_context, 'field_' ~ field).required and field != 'postcode' %}{{ text_not_required }}{% endif %}</label>
	  <input type="text" name="{{ field }}" placeholder="{{ attribute(_context, 'field_' ~ field).placeholder }}" value="{{ attribute(_context, field) ? attribute(_context, field) : attribute(_context, 'field_' ~ field).default }}" class="form-control"  id="input-payment-{{ field|replace({'_' : '-'}) }}" />
	</div>
	{% else %}   
	<input type="text" name="{{ field }}" value="{{ attribute(_context, field) ? attribute(_context, field) : attribute(_context, 'field_' ~ field).default }}" class="hide" />
	{% endif %}
  {% endif %}
{% endfor %}
</div>

