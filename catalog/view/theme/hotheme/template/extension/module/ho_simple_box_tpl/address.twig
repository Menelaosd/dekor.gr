<div class="home-info-address-block full-container">
	<div class="home-info-address-block-container">
		<img class="background-image img-fluid" src="{{box.image}}" alt="{{box.text}}" />
		<div style="background:url('{{box.image2}}') left bottom repeat-x;" class="container img-overlay">
			<div class="row">
				<div class="col-12 col-sm-6">
					<div class="home-info-address-block-text-1">
						{{box.text}}
					</div>
					<div class="home-info-address-block-text-2">
						{{box.text2}}
					</div>
				</div>
				<div class="col-12 col-sm-6 home-info-address-block-right">
					<div class="home-info-address-block-text-subtitle">
						{{box.subtitle}}
					</div>
				</div>	
			</div>
		</div>
	</div>
</div>