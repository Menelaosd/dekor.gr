						<td style="text-align:center;border-bottom: 2px solid #ddd;padding:5px;vertical-align: bottom;"></td>
						<td style="text-align:center;border-bottom: 2px solid #ddd;border-right: 2px solid #ddd;padding:5px;vertical-align: bottom;white-space: nowrap;">
							<div style="font-weight:bold;white-space:nowrap">
							{{ text_your_order_des }}
							</div>
							{#
							<br>
							<span style="font-size:11px;line-height: normal;display: block;">
								<span style="white-space:nowrap">(Χρώμα, Μέγεθος,</span><br> 
								<span style="white-space:nowrap">Ποσότητα Συσκευασίας)</span>
							</span>
							#}
						</td>
						<td style="text-align:center;border-bottom: 2px solid #ddd;border-right: 2px solid #ddd;padding:5px;vertical-align: bottom;white-space: nowrap;">
						<div style="font-weight:bold;white-space:nowrap">
							{{ text_your_order_qua }}
						</div>
						</td>
						<td style="text-align:center;border-bottom: 2px solid #ddd;border-right: 2px solid #ddd;padding:5px;vertical-align: bottom;white-space: nowrap;">
							<div style="font-weight:bold;white-space:nowrap">
							{{ text_your_order_price }} 
							</div>
							<div style="font-weight:bold;white-space:nowrap">
							{{ text_your_order_package }}	
							</div>
						</td>
						<td style="text-align:center;border-bottom: 2px solid #ddd;border-right: 2px solid #ddd;padding:5px;vertical-align: bottom;white-space: nowrap;">
						<div style="font-weight:bold;white-space:nowrap">{{ text_your_order_discount }}</div></td>
						<td style="text-align:center;border-bottom: 2px solid #ddd;padding:5px;vertical-align: bottom;white-space: nowrap;">
						<div style="font-weight:bold;white-space:nowrap">{{ text_your_order_total_amount }}</div></td>
					</tr>
					</thead>
					
					  <tbody>
						{% for product in products %}
						<tr>
						
							<td style="text-align:center;padding:5px;border-bottom:solid 2px #ddd">
								<img style="max-width:120px;height:auto" src="{{ product.thumb }}">
							</td>
							<td style="text-align:center;padding:5px;border-bottom:solid 2px #ddd">
								<div style="margin-top:15px"></div>
								<div style="font-size:13.6px;line-height:normal;">
								SKU: {{ product.model }}<br><br>
								{{ product.name }}<br>
								<span style="color:#999;padding-top:10px;">{{ product.connected_color }}</span><br>
								<span style="color:#999">{{ product.connected_size }}</span><br><br>

								{% if lang_id == 2 %}Συσκευασία{% else %}Package{% endif %}<br>({{ product.package }} {{ product.unit }})
								</div>
								<div style="margin-top:15px"></div>
							</td>
						  
							<td style="text-align:center;padding:5px;border-bottom:solid 2px #ddd"><span style="font-size:13.6px">{{ product.quantity }}</span></td>
						  <td style="text-align:center;padding:5px;border-bottom:solid 2px #ddd"><span style="font-size:13.6px">{{ product.price }}</span></td>
						  <td style="text-align:center;padding:5px;border-bottom:solid 2px #ddd"><span style="font-size:13.6px">{{ product.discount }}</span></td>
						  <td style="text-align:center;padding:5px;font-size:17px;border-bottom:solid 2px #ddd">{{ product.total }}</td>
						</tr>
						{% endfor %}
						
						{#
						{% for voucher in order.voucher %}
						<tr>
						  <td>{{ voucher.description }}</td>
						  <td></td>
						  <td class="text-right">1</td>
						  <td class="text-right">{{ voucher.amount }}</td>
						  <td class="text-right">{{ voucher.amount }}</td>
						</tr>
						{% endfor %}
						#}
						
						<tr>
							<td colspan="6">
								<div style="min-height:60px;"></div>
							</td>
						</tr>
					
					  </tbody>    
				  </table>
				  
				  
				  </div>
				  
				<table style=" border-collapse: collapse; border:none;margin-bottom: 20px;width:100%;">
				{% for total in totals %}				
					{% if not total.hide %}
					
					<tr {% if total.code == 'total' %}style="font-size:30.2px;font-weight:bold"{% else %}style="font-size:20.7px;font-weight:normal"{% endif %}>
					  <td style="width:40%"></td>
					  <td style="text-align:right;padding:5px;{% if total.code == 'total' %}padding-top:15px;border-top:solid 2px #ddd;{% endif %}">	  
							{{ total.title }}: 	  
					  </td>
					  <td style="text-align:right;padding:5px;width: 1%;white-space: nowrap;{% if total.code == 'total' %}border-top:solid 2px #ddd;padding-top:15px;{% endif %}">{% if total.code == 'xcod' or total.code == 'shipping' and total.attach %}+{% endif%}{{ total.text }}</td>
					  
					</tr>
					
					{% endif %}
				{% endfor %}
				</table>
				  
				  
				  <p style="border-top: 2px solid #ddd; margin: 20px 0 20px 0;padding-top:20px;text-align:center;font-size:15.1px">{{ text_footer }}</p>
				  

                        </td>
                    </tr>
                </tbody></table>
				<!--[if mso]>
				</td>
				<![endif]-->
                
				<!--[if mso]>
				</tr>
				</table>
				<![endif]-->
            </td>
        </tr>
    </tbody>
</table></td>
                            </tr>
                            <tr>
                                <td valign="top" id="templateFooter"></td>
                            </tr>
                        </table>
                        <!--[if (gte mso 9)|(IE)]>
                        </td>
                        </tr>
                        </table>
                        <![endif]-->
                        <!-- // END TEMPLATE -->
                    </td>
                </tr>
            </table>
        </center>
    </body>
</html>
