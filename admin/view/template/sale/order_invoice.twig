<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<title>{{ title }}</title>
<base href="{{ base }}" />
<link href="view/javascript/bootstrap/css/bootstrap.css" rel="stylesheet" media="all" />
<script type="text/javascript" src="view/javascript/jquery/jquery-2.1.1.min.js"></script>
<script type="text/javascript" src="view/javascript/bootstrap/js/bootstrap.min.js"></script>
<link href="view/javascript/font-awesome/css/font-awesome.min.css" type="text/css" rel="stylesheet" />
<link type="text/css" href="view/stylesheet/stylesheet.css" rel="stylesheet" media="all" />
</head>
<body>
<div class="container">
  {% for order in orders %}
  <div {% if orders|length > 1 and not loop.last %}style="page-break-after: always;"{% endif %}>
      </br></br>
    <h1>{{ text_invoice }} #{{ order.order_id }} - {{ order.date_added }}</h1>
    <table class="table table-bordered" style="display:none">
      <thead>
        <tr>
          <td colspan="2">{{ text_order_detail }}</td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="width: 50%;"><address>
            <strong>{{ order.store_name }}</strong><br />
            {{ order.store_address }}
            </address>
            <b>{{ text_telephone }}</b> {{ order.store_telephone }}<br />
            {% if order.store_fax %}
            <b>{{ text_fax }}</b> {{ order.store_fax }}<br />
            {% endif %}
            <b>{{ text_email }}</b> {{ order.store_email }}<br />
            <b>{{ text_website }}</b> <a href="{{ order.store_url }}">{{ order.store_url }}</a></td>
          <td style="width: 50%;"><b>{{ text_date_added }}</b> {{ order.date_added }}<br />
            {% if order.invoice_no %}
            <b>{{ text_invoice_no }}</b> {{ order.invoice_no }}<br />
            {% endif %}
            <b>{{ text_order_id }}</b> {{ order.order_id }}<br />
            <b>{{ text_payment_method }}</b> {{ order.payment_method }}<br />
            {% if order.shipping_method %}
            <b>{{ text_shipping_method }}</b> {{ order.shipping_method }}<br />
            {% endif %}</td>
        </tr>
      </tbody>
    </table>
    <table class="table table-bordered">
      <thead>
        <tr>
          <td style="width: 50%;"><b>{{ text_payment_address }}</b></td>
          <td style="width: 50%;"><b>{{ text_shipping_address }}</b></td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><address>
		  {% if order.customer_group_id == 3 %}
			<h3>ΤΙΜΟΛΟΓΙΟ</h3>
		  {% else %}
		  <h3>ΑΠΟΔΕΙΞΗ</h3>
		  {% endif %}
            {{ order.payment_address }}</br></br>{{ order.telephone }}</br></br>
            Τρόπος Πληρωμής: {{ order.payment_method }}</br></br>
            {% if order.payment_custom_field %}
                {% for key,value in order.payment_custom_field %}
                    {% if key == 2 and value %}
                        ΕΠΑΓΓΕΛΜΑ: {{ value }}</br>
                     {% endif %}
                    {% if key == 3 and value %}
                        ΑΦΜ: {{ value }}</br>
                     {% endif %}
                    {% if key == 4 and value %}
                        ΔΟΥ: {{ value }}</br>
                     {% endif %}
                {% endfor %}
            {% endif %}
            {% if order.custom_field and not order.payment_custom_field %}
                {% for key,value in order.custom_field %}
                    {% if key == 2 and value %}
                        ΕΠΑΓΓΕΛΜΑ: {{ value }}</br>
                     {% endif %}
                    {% if key == 3 and value %}
                        ΑΦΜ: {{ value }}</br>
                     {% endif %}
                    {% if key == 4 and value %}
                        ΔΟΥ: {{ value }}</br>
                     {% endif %}
                {% endfor %}
            {% endif %}
            </address></td>
          <td><address>
            {{ order.shipping_address }}</br></br>{{ order.telephone }}
            </address></td>
        </tr>
      </tbody>
    </table>
    <table class="table table-bordered">
      <thead>
        <tr>
          <td><b>{{ column_product }}</b></td>
          <td><b>{{ column_model }}</b></td>
          <td class="text-center"><b>{{ column_quantity }}</b></td>
			{#
			<td align="right">Χωρίς Φ.Π.Α.</td>
			<td align="right">Φ.Π.Α.</td>
			#}
          <td class="text-right"><b>{{ column_price }}</b></td>
          <td class="text-right"><b>Τιμή Συσκ.</b></td>
          <td class="text-right"><b>{{ column_total }}</b></td>
        </tr>
      </thead>
      <tbody>
        {% for product in order.product %}
        <tr>
          <td>{{ product.name }}
            {% for option in product.option %}
            <br />
            &nbsp;<small> - {{ option.name }}: {{ option.value }}</small>
            {% endfor %}</td>
          <td>{{ product.model }}</td>

            <td class="text-center">
				{{ product.quantity }}{% if product.package > 1%}<b> x {{ product.package }}</b>{% endif %}
			</td>
		
			{#
				<td align="right">{{ product.pricenotax }}</td>
				<td align="right">{{ product.simpletax }}</td>
			#}
	  
          <td class="text-right">{{ product.package_price }}</td>
          <td class="text-right">{{ product.price }}</td>
          <td class="text-right">{{ product.total }}</td>
        </tr>
        {% endfor %}
        {% for voucher in order.voucher %}
        <tr>
          <td>{{ voucher.description }}</td>
          <td></td>
          <td class="text-right">1</td>
          <td class="text-right">{{ voucher.amount }}</td>
          <td class="text-right">{{ voucher.amount }}</td>
        </tr>
        {% endfor %}
        {% for total in order.total %}
        <tr>
          <td class="text-right" colspan="5"><b>{{ total.title }}</b></td>
          <td class="text-right">{{ total.text }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if order.comment %}
    <table class="table table-bordered">
      <thead>
        <tr>
          <td><b>{{ text_comment }}</b></td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ order.comment }}</td>
        </tr>
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endfor %}
</div>
<style type="text/css">
	@media print {
		h1,h3 {
			font-size:17px;
		}
		body td,body th {
			font-size:12px !important;
			padding:5px !important;
		}
		address {
			margin-bottom: 0;
			font-style: normal;
			line-height: 1.42857143;
		}
	}
</style>
</body>
</html>
