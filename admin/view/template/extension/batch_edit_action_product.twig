{% for field in text_fields %}
<div class="form-group action-group-product-{{ field.input }}">
	<label class="col-sm-{{ col1 }} control-label" for="action[product][{{ field.input }}][find]">{{ field.label }} {% if field.prefix == 'pd' %}<span data-toggle="tooltip" title="{{ help_language }}"></span>{% endif %}</label>
	<div class="col-sm-2">
		<select name="action[product][{{ field.input }}][action]" class="form-control" onchange="$(this).parent().parent().find('.text-action').hide(); $(this).parent().parent().find('.text-action.text-'+$(this).val()+'').show();">
			<option value="">{{ text_replace }}</option>
			<option value="set">{{ text_set }}</option>
			<option value="prepend">{{ text_prepend }}</option>
			<option value="append">{{ text_append }}</option>
			<option value="clear">{{ tab_clear }}</option>
		</select>
	</div>
	<div class="text-action text-">
		<div class="col-sm-3">
			<input type="text" value="" placeholder="{{ text_find }}" id="action[product][{{ field.input }}][find]" name="action[product][{{ field.input }}][find]" class="form-control" />
		</div>
		<label class="col-sm-1 control-label" for="action[product][{{ field.input }}][replace]" style="text-align:center;"><i class="fa fa-arrow-right"></i></label>
		<div class="col-sm-3">
			<input type="text" value="" placeholder="{{ text_replace }}" id="action[product][{{ field.input }}][replace]" name="action[product][{{ field.input }}][replace]" class="form-control" />
		</div>
	</div>
	<div class="text-action text-set text-append text-prepend" style="display:none;">
		<div class="col-sm-7">
			{% if field.type == 'text' or field.type == 'mediumtext'  or field.type == 'longtext' %}
			<textarea name="action[product][{{ field.input }}][set]" rows="3" class="form-control"></textarea>
			{% else %}
			<input type="text" value="" name="action[product][{{ field.input }}][set]" class="form-control" />
			{% endif %}
		</div>
	</div>
	<div class="text-action text-clear" style="display:none;">
		<div class="col-sm-7"></div>
	</div>
	<div class="col-sm-{{ col5 }} hide-filter"><button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></div>
</div>
{% endfor %}
