<h4>{{ tab_action_product }}</h4>
<hr/>
{% set col1 = '2' %}
{% set col2 = '2' %}
{% set col3 = '4' %}
{% set col4 = '3' %}
{% set col5 = '1' %}
<div class="row form-row">
	<div class="pull-right dropdown" style="padding-bottom:5px;">
		<button type="button" data-toggle="dropdown" title="{{ button_add_filter }}" class="btn btn-primary dropdown-toggle btn-product-field" style="padding: 5px 13px;"><i class="fa fa-plus"></i>&nbsp;<span class="caret"></span></button>
		<ul class="dropdown-menu">
			<li><a data-product_field="product-price">{{ entry_price }}</a></li>
			<li><a data-product_field="product-tax_class_id">{{ entry_tax_class }}</a></li>
			<li><a data-product_field="product-quantity">{{ entry_quantity }}</a></li>
			<li><a data-product_field="product-minimum">{{ entry_minimum }}</a></li>
			<li><a data-product_field="product-subtract">{{ entry_subtract }}</a></li>
			<li><a data-product_field="product-shipping">{{ entry_shipping }}</a></li>
			<li><a data-product_field="product-stock_status_id">{{ entry_stock_status }}</a></li>
			<li><a data-product_field="product-status">{{ entry_status }}</a></li>
			<li><a data-product_field="product-sort_order">{{ entry_sort_order }}</a></li>
			<li><a data-product_field="product-manufacturer">{{ entry_manufacturer }}</a></li>
			<li class="divider"></li>
			{% for field in text_fields %}
			<li><a data-product_field="product-{{ field.input }}">{{ field.label }}</a></li>
			{% endfor %}
			<li class="divider"></li>
			<li><a data-product_field="product-date_available">{{ entry_date_available }}</a></li>
			<li><a data-product_field="product-date_added">{{ entry_date_added }}</a></li>
			<li><a data-product_field="product-date_modified">{{ entry_date_modified }}</a></li>
			<li><a data-product_field="product-quantity">{{ entry_quantity }}</a></li>
			<li><a data-product_field="product-points">{{ entry_points }}</a></li>
			<li><a data-product_field="product-weight_class_id">{{ entry_weight_class }}</a></li>
			<li><a data-product_field="product-weight">{{ entry_weight }}</a></li>
			<li><a data-product_field="product-length_class_id">{{ entry_length_class }}</a></li>
			<li><a data-product_field="product-length">{{ entry_length }}</a></li>
			<li><a data-product_field="product-width">{{ entry_width }}</a></li>
			<li><a data-product_field="product-height">{{ entry_height }}</a></li>
			{% if custom_fields %}
			<li class="divider"></li>
			{% for field in custom_fields %}
			<li><a data-product_field="custom-product-{{ field.input }}">{{ field.label }}</a></li>
			{% endfor %}
			{% endif %}
		</ul>
	</div>
	<h4>{{ text_update_existing }}</h4>
	<hr>
</div>
<div class="form-group action-group-product-price action-group-default">
	<label class="col-sm-{{ col1 }} control-label">{{ entry_price }}</label>
	<div class="col-sm-{{ col2 }}">
		<select name="action[product][price][sign]" class="form-control">
			<option value="-">-</option>
			<option value="+">+</option>
			<option value="*">*</option>
			<option value="/">/</option>
			<option value="=">=</option>
		</select>
	</div>
	<div class="col-sm-{{ col3 }}">
		<input type="text" name="action[product][price][value]" value="" placeholder="0.00" class="form-control" />
	</div>
	<div class="col-sm-{{ col4 }}">
		<select name="action[product][price][type]" class="form-control">
			<option value="p">{{ text_percent }}</option>
			<option value="f">{{ text_fixed }}</option>
		</select>
	</div>
	<div class="col-sm-{{ col5 }} hide-filter"><button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></div>
</div>
