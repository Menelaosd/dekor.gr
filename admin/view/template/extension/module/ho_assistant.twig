{{ header }}{{ column_left }}
{# dekor: this admin is OpenCart 3 / Bootstrap 3 / Font Awesome 4 — the package's page rewritten in the same markup as the
   store's other module pages (form-horizontal, form-group, help-block, pull-right) #}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    {% if stores|length > 1 %}
    <ul class="nav nav-tabs hoa-stores">
      {% for s in stores %}
      <li{% if s.store_id == store_id %} class="active"{% endif %}><a href="{{ s.href }}"><i class="fa fa-shopping-bag"></i> {{ s.name }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if not switch_on %}
    <div class="alert alert-warning"><i class="fa fa-power-off"></i> {{ text_switch_off }}</div>
    {% elseif not ready %}
    <div class="alert alert-warning"><i class="fa fa-key"></i> {{ text_no_key }}</div>
    {% elseif only_customer %}
    <div class="alert alert-info"><i class="fa fa-user-secret"></i> {{ text_only_customer_on|format(only_customer) }}</div>
    {% else %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_switch_on }}</div>
    {% endif %}

    <div class="row">
      <div class="col-sm-4">
        <div class="panel panel-default hoa-stat">
          <div class="panel-body">
            <div class="hoa-stat__label">{{ text_today }}</div>
            <div class="hoa-stat__value">{{ today.requests }} <small>{{ text_requests }}</small></div>
            <div class="text-muted">{{ text_cost }}: ${{ today.cost|number_format(4) }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="panel panel-default hoa-stat">
          <div class="panel-body">
            <div class="hoa-stat__label">{{ text_month }}</div>
            <div class="hoa-stat__value">{{ month.requests }} <small>{{ text_requests }}</small></div>
            <div class="text-muted">{{ text_cost }}: ${{ month.cost|number_format(4) }}</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="panel panel-default hoa-stat">
          <div class="panel-body">
            <div class="hoa-stat__label">{{ text_month }}</div>
            <div class="hoa-stat__value">{{ orders }} <small>{{ text_orders }}</small></div>
            <div class="text-muted">&nbsp;</div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <p class="text-muted">{{ text_intro }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal" autocomplete="off">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ text_tab_general }}</a></li>
            <li><a href="#tab-texts" data-toggle="tab">{{ text_tab_texts }}</a></li>
            <li><a href="#tab-orders" data-toggle="tab">{{ text_tab_orders }}</a></li>
            <li><a href="#tab-log" data-toggle="tab">{{ text_tab_log }}</a></li>
          </ul>
          <div class="tab-content">

            {# ---------------------------------------------------------------- general #}
            <div class="tab-pane active" id="tab-general">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_store_status }}</label>
                <div class="col-sm-10">
                  <div class="checkbox">
                    <label><input type="checkbox" name="status" value="1" id="input-status"{% if status %} checked="checked"{% endif %} /> <strong>{{ text_store_status }}</strong></label>
                  </div>
                  <span class="help-block">{{ help_store_status }}</span>
                </div>
              </div>
              <div class="form-group{% if only_customer_missing %} has-error{% endif %}">
                <label class="col-sm-2 control-label" for="input-only-customer">{{ entry_only_customer }}</label>
                <div class="col-sm-10">
                  <input type="email" name="only_customer" value="{{ only_customer }}" placeholder="email@example.com" id="input-only-customer" class="form-control" autocomplete="off" />
                  {% if only_customer_missing %}<div class="text-danger">{{ error_only_customer }}</div>{% endif %}
                  <span class="help-block">{{ help_only_customer }}</span>
                </div>
              </div>

              {% if store_id %}
              <div class="alert alert-info"><i class="fa fa-link"></i> {{ text_common_settings }}</div>
              {% else %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-key">{{ entry_key }}</label>
                <div class="col-sm-10">
                  {% if key_file %}<div class="alert alert-info"><i class="fa fa-file-code-o"></i> {{ text_key_file|format(key_file) }}</div>{% endif %}
                  <input type="password" name="key" value="" placeholder="sk-…" id="input-key" class="form-control" autocomplete="new-password" />
                  {% if key_saved %}
                  <div class="checkbox"><label>{{ text_key_saved|format(key_saved) }} · <input type="checkbox" name="key_remove" value="1" /> {{ text_key_remove }}</label></div>
                  {% endif %}
                  <span class="help-block">{{ help_key }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-anthropic-key">{{ entry_anthropic_key }}</label>
                <div class="col-sm-10">
                  {% if anthropic_key_file %}<div class="alert alert-info"><i class="fa fa-file-code-o"></i> {{ text_anthropic_key_file|format(anthropic_key_file) }}</div>{% endif %}
                  <input type="password" name="anthropic_key" value="" placeholder="sk-ant-…" id="input-anthropic-key" class="form-control" autocomplete="new-password" />
                  {% if anthropic_key_saved %}
                  <div class="checkbox"><label>{{ text_key_saved|format(anthropic_key_saved) }} · <input type="checkbox" name="anthropic_key_remove" value="1" /> {{ text_key_remove }}</label></div>
                  {% endif %}
                  <span class="help-block">{{ help_anthropic_key }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-model">{{ entry_model }}</label>
                <div class="col-sm-10">
                  <select name="model" id="input-model" class="form-control">
                    {% for m in models %}
                    <option value="{{ m }}"{% if m == model %} selected="selected"{% endif %}>{{ m }}</option>
                    {% endfor %}
                    <option value="mock"{% if model == 'mock' %} selected="selected"{% endif %}>{{ text_mock }}</option>
                  </select>
                  <span class="help-block">{{ help_model }}</span>
                </div>
              </div>
              {% endif %}

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-profile">{{ entry_profile }}</label>
                <div class="col-sm-10">
                  <p>
                    <button type="button" id="button-profile" class="btn btn-primary"><i class="fa fa-magic"></i> {{ profile ? button_profile_again : button_profile }}</button>
                    &nbsp;<span id="profile-status" class="text-muted">{{ profile ? '' : text_profile_empty }}</span>
                  </p>
                  <textarea name="profile" rows="16" placeholder="{{ text_profile_placeholder }}" id="input-profile" class="form-control hoa-mono">{{ profile }}</textarea>
                  <span class="help-block">{{ help_profile }}</span>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-instructions">{{ entry_instructions }}</label>
                <div class="col-sm-10">
                  <textarea name="instructions" rows="4" id="input-instructions" class="form-control">{{ instructions }}</textarea>
                  <span class="help-block">{{ help_instructions }}</span>
                </div>
              </div>
            </div>

            {# ---------------------------------------------------------------- texts per language #}
            <div class="tab-pane" id="tab-texts">
              <p class="text-muted">{{ help_texts }}</p>
              {% for language in languages %}
              <fieldset>
                <legend><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-name-{{ language.language_id }}">{{ entry_name }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="name[{{ language.language_id }}]" value="{{ names[language.language_id] }}" id="input-name-{{ language.language_id }}" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-greeting-{{ language.language_id }}">{{ entry_greeting }}</label>
                  <div class="col-sm-10">
                    <textarea name="greeting[{{ language.language_id }}]" rows="3" id="input-greeting-{{ language.language_id }}" class="form-control">{{ greetings[language.language_id] }}</textarea>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-suggestions-{{ language.language_id }}">{{ entry_suggestions }}</label>
                  <div class="col-sm-10">
                    <textarea name="suggestions[{{ language.language_id }}]" rows="4" id="input-suggestions-{{ language.language_id }}" class="form-control">{{ suggestions[language.language_id] }}</textarea>
                  </div>
                </div>
              </fieldset>
              {% endfor %}
            </div>

            {# ---------------------------------------------------------------- orders and limits #}
            <div class="tab-pane" id="tab-orders">
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_payments }}</label>
                <div class="col-sm-10">
                  {% for pm in payment_methods %}
                  <div class="checkbox">
                    <label><input type="checkbox" name="payments[]" value="{{ pm.code }}"{% if pm.code in payments %} checked="checked"{% endif %} /> <strong>{{ pm.name }}</strong> <span class="text-muted">· {{ pm.offline ? text_offline : text_online }}</span></label>
                  </div>
                  {% endfor %}
                </div>
              </div>
              {% if store_id %}
              <div class="alert alert-info"><i class="fa fa-link"></i> {{ text_common_settings }}</div>
              {% else %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-budget">{{ entry_budget }}</label>
                <div class="col-sm-3"><input type="number" step="0.5" min="0" name="budget" value="{{ budget }}" id="input-budget" class="form-control" /></div>
                <div class="col-sm-7"><span class="help-block">{{ help_budget }}</span></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-rate">{{ entry_rate }}</label>
                <div class="col-sm-3"><input type="number" min="1" name="rate" value="{{ rate }}" id="input-rate" class="form-control" /></div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-retention">{{ entry_retention }}</label>
                <div class="col-sm-3"><input type="number" min="1" name="retention" value="{{ retention }}" id="input-retention" class="form-control" /></div>
                <div class="col-sm-7"><span class="help-block">{{ help_retention }}</span></div>
              </div>
              {% endif %}
            </div>

            {# ---------------------------------------------------------------- conversations #}
            <div class="tab-pane" id="tab-log">
              {% if chats %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <tbody>
                    {% for c in chats %}
                    <tr>
                      <td class="text-left" style="white-space:nowrap">{{ c.date }}</td>
                      <td class="text-left">{{ c.first }}</td>
                      <td class="text-left" style="white-space:nowrap">{{ c.turns }} · {{ c.cost }}</td>
                      <td class="text-left" style="white-space:nowrap">{% if c.order %}<a href="{{ c.order }}" class="label label-success">{{ text_order|format(c.order_id) }}</a>{% endif %}</td>
                      <td class="text-right"><button type="button" class="btn btn-default btn-sm" data-chat="{{ c.chat_id }}"><i class="fa fa-eye"></i> {{ text_view }}</button></td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              {% else %}
              <p class="text-muted text-center" style="padding:20px 0">{{ text_no_chats }}</p>
              {% endif %}
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-chat" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">{{ text_tab_log }}</h4>
      </div>
      <div class="modal-body" id="chat-body" style="max-height:70vh;overflow-y:auto"></div>
    </div>
  </div>
</div>

<style>
.hoa-stores { margin-bottom: 15px; }
.hoa-stat .panel-body { padding: 12px 15px; }
.hoa-stat__label { color: #777; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
.hoa-stat__value { font-size: 24px; font-weight: 600; line-height: 1.3; }
.hoa-stat__value small { font-size: 13px; font-weight: 400; color: #777; }
#form-module .tab-content { padding-top: 20px; }
.hoa-mono { font-family: Menlo, Consolas, monospace; font-size: 12px; }
.hoa-msg { margin-bottom: 12px; }
.hoa-msg__who { color: #777; font-size: 11px; margin-bottom: 2px; }
.hoa-msg__text { display: inline-block; max-width: 85%; padding: 8px 12px; border-radius: 6px; background: #f2f2f2; white-space: pre-wrap; text-align: left; }
.hoa-msg--user { text-align: right; }
.hoa-msg--user .hoa-msg__text { background: #1e91cf; color: #fff; }
</style>
<script type="text/javascript"><!--
// «build the store profile»: one request, the text lands in the field (already saved by the server)
$('#button-profile').on('click', function () {
	var button = $(this);
	var field = $('#input-profile');
	var status = $('#profile-status');

	if ($.trim(field.val()) !== '' && !confirm({{ text_profile_confirm|json_encode }})) {
		return;
	}

	button.prop('disabled', true);
	status.attr('class', 'text-muted').text({{ text_profile_working|json_encode }});

	$.ajax({
		url: {{ profile_url|json_encode }},
		type: 'post',
		dataType: 'json',
		success: function (d) {
			button.prop('disabled', false);

			if (d.error) {
				status.attr('class', 'text-danger').text(d.error);

				return;
			}

			field.val(d.profile);
			status.attr('class', d.warning ? 'text-warning' : 'text-success').text((d.warning ? d.warning + ' ' : '') + d.success);
		},
		error: function () {
			button.prop('disabled', false);
			status.attr('class', 'text-danger').text({{ text_profile_failed|json_encode }});
		}
	});
});

// a conversation in the modal (what the customer typed is escaped: never raw HTML in the admin)
$(document).on('click', '[data-chat]', function () {
	var body = $('#chat-body');
	var esc = function (s) { return $('<div>').text(String(s || '')).html(); };

	body.html('…');
	$('#modal-chat').modal('show');

	$.getJSON({{ chat_url|json_encode }} + '&chat_id=' + $(this).attr('data-chat'), function (d) {
		body.html((d.log || []).map(function (m) {
			var who = m.role === 'user' ? {{ text_customer|json_encode }} : {{ text_assistant|json_encode }};
			var cards = m.cards ? ' <span class="text-muted">' + esc({{ text_cards|json_encode }}.replace('%s', m.cards)) + '</span>' : '';

			return '<div class="hoa-msg' + (m.role === 'user' ? ' hoa-msg--user' : '') + '"><div class="hoa-msg__who">' + esc(who) + '</div><div class="hoa-msg__text">' + esc(m.text) + cards + '</div></div>';
		}).join(''));
	});
});
//--></script>
{{ footer }}
