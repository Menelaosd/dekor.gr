{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a onclick="$('#action').val('save_stay');$('#form-ho_testimonials').submit();" title="{{ button_save_continue }}" class="btn btn-success">
          <i class="fa fa-save"></i> {{ button_save_continue }}
        </a>
        <a onclick="$('#form-ho_testimonials').submit();" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i> {{ button_save }}
        </a>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
          <i class="fa fa-reply"></i> {{ button_cancel }}
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-ho_testimonials" class="form-horizontal">
          <input type="hidden" name="action" id="action" value="">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>		  
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-limit">{{ entry_testimonials }}</label>
            <div class="col-sm-10">
				<table id="testimonials" class="table table-striped table-bordered table-hover">
				  <thead>
					<tr>
					  <td class="text-left">{{ entry_author }}</td>
					  <td class="text-left">{{ entry_comments }}</td>
					  <td class="text-right">{{ entry_sort_order }}</td>
					  <td class="text-right"></td>
					</tr>
				  </thead>
				  <tbody>  
				  {% set testimonial_row = 0 %}
					{% if testimonials is empty %}
					  <tr id="testimonial-row{{ testimonial_row }}">
						<td class="text-left" style="width: 30%;">
						{% for language in languages %}
							<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
								<input type="text" name="testimonials[{{ testimonial_row }}][testimonial_description][{{ language.language_id }}][author]" value="" placeholder="{{ entry_comments }}" class="form-control" />
							</div>
						{% endfor %}
						</td>
						<td class="text-left" style="width: 40%;">
						{% for language in languages %}
							<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
								<textarea name="testimonials[{{ testimonial_row }}][testimonial_description][{{ language.language_id }}][comments]" placeholder="{{ entry_comments }}" class="form-control" /></textarea>
							</div>
						{% endfor %}
						</td> 
						<td class="text-left" style="width: 20%;">
							<input type="text" name="testimonials[{{ testimonial_row }}][sort_order]" value="0" placeholder="{{ entry_sort_order }}" class="form-control" />
						</td> 
						<td class="text-right"><button type="button" onclick="$('#filter-row{{ filter_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
					  </tr>
					{% set testimonial_row = testimonial_row + 1 %}
					{% endif %}
				  {% for testimonial in testimonials %}
				  <tr id="testimonial-row{{ testimonial_row }}">
					<td class="text-left" style="width: 30%;">
					{% for language in languages %}
					<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
					<input type="text" name="testimonials[{{ testimonial_row }}][testimonial_description][{{ language.language_id }}][author]" value="{{ testimonial.testimonial_description[language.language_id] ? testimonial.testimonial_description[language.language_id].author }}" placeholder="{{ entry_author }}" class="form-control" />
					</div>
					{% endfor %}
					</td>
					<td class="text-left" style="width: 40%;">
					{% for language in languages %}
					<div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
						<textarea name="testimonials[{{ testimonial_row }}][testimonial_description][{{ language.language_id }}][comments]" placeholder="{{ entry_comments }}" class="form-control" />{{ testimonial.testimonial_description[language.language_id] ? testimonial.testimonial_description[language.language_id].comments }}</textarea>
					</div>
					{% endfor %}
					</td> 
					<td class="text-left" style="width: 20%;">
					<input type="text" name="testimonials[{{ testimonial_row }}][sort_order]" value="{{ testimonial.sort_order }}" placeholder="{{ entry_sort_order }}" class="form-control" />
					</td> 
					<td class="text-right"><button type="button" onclick="$('#testimonial-row{{ testimonial_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
				  </tr>
				  {% set testimonial_row = testimonial_row + 1 %}
				  {% endfor %}
					</tbody>
					  <tfoot>
						<tr>
						  <td colspan="3"></td>
						  <td class="text-right"><button type="button" onclick="addTestimonialRow();" data-toggle="tooltip" title="{{ button_testimonial_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
						</tr>
					  </tfoot>
				</table>
            </div>
          </div>
		  
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                  {% if status %}  
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
             {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
  </div>
  <script type="text/javascript"><!--
var testimonial_row = {{ testimonial_row }};

function addTestimonialRow() {
	html  = '<tr id="testimonial-row' + testimonial_row + '">';

	html += '  <td class="text-left" style="width: 30%;">';
	{% for language in languages %}	
	html += '  <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>';
	html += '  <input type="text" name="testimonials[' + testimonial_row + '][testimonial_description][{{ language.language_id }}][author]" value="" placeholder="{{ entry_author }}" class="form-control" />';
	html += '  </div>';
	{% endfor %}
	html += '  </td>';
	html += '  <td class="text-left" style="width: 40%;">';
	{% for language in languages %}	
	html += '  <div class="input-group"><span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>';
	html += '  <textarea name="testimonials[' + testimonial_row + '][testimonial_description][{{ language.language_id }}][comments]" value="" placeholder="{{ entry_author }}" class="form-control" /></textarea>';
	html += '  </div>';
	{% endfor %}
	html += '  </td>';
	html += '  <td class="text-left" style="width: 20%;"><input type="text" name="testimonials[' + testimonial_row + '][sort_order]" value="0" placeholder="{{ entry_sort_order }}" class="form-control" /></td>';
	html += '  <td class="text-right"><button type="button" onclick="$(\'#testimonial-row' + testimonial_row + '\').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
	html += '</tr>';

	$('#testimonials tbody').append(html);

	testimonial_row++;
}
//--></script>
{{ footer }}    