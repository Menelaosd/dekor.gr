		    }	     
		    
		    let obj_price = $(this).closest('tr').find("td:eq(4) div.cls-oop-div-edit:visible"); 
		    if(obj_price.length) {
			html += "<input name='oopdata[" + product_id + "][price]' value='" + $(obj_price).find('input').val() + "' />";
		    }	
		    
		    let obj_quantity = $(this).closest('tr').find("td:eq(5) div.cls-oop-div-edit:visible"); 
		    if(obj_quantity.length) {
			html += "<input name='oopdata[" + product_id + "][quantity]' value='" + $(obj_quantity).find('input').val() + "' />";
		    }	  

			let obj_status = $(this).closest('tr').find("td:eq(6) div.cls-oop-div-edit:visible"); 
		    if(obj_status.length) {
