{{ header }}{{ column_left }}
{% if setting_mod %}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group row mb-3">
            <label class="col-sm-2 control-label" for="input-c2p-display">{{ text_oop_display_menu }}</label>
            <div class="col-sm-10">
              <select name="module_oop_categories_plus_display" id="input-c2p-display" class="form-control">
                <option value="0" {% if module_oop_categories_plus_display == 0 %} selected="selected" {% endif %}>{{ text_oop_collapsed }}</option>
                <option value="1" {% if module_oop_categories_plus_display == 1 %} selected="selected" {% endif %}>{{ text_oop_partially_opened }}</option>                
                <option value="2" {% if module_oop_categories_plus_display == 2 %} selected="selected" {% endif %}>{{ text_oop_opened }}</option>
              </select>
            </div>
          </div>
          
          <div id="div-c2p-partially_opened" class="form-group row mb-3" {% if module_oop_categories_plus_display == 1 %} style="display:flex;" {% else %} style="display:none;"  {% endif %}>
            <label class="col-sm-2 control-label" for="input-c2p-partially_opened">{{ text_oop_open_levels_count }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_oop_categories_plus_partially_opened" id="input-c2p-partially_opened" value="{{ module_oop_categories_plus_partially_opened }}" placeholder="{{ text_oop_open_levels_count }}" id="input-c2p-partially_opened" class="form-control" />
            </div>
          </div>      
          
	  <div class="form-group row mb-3">
	      <label class="col-sm-2 control-label" for="input-c2p-subcats_products">{{ text_oop_subcats_products }}</label>
	      <div class="col-sm-10">
		<select name="module_oop_categories_plus_subcats_products" id="input-c2p-subcats_products" class="form-control">
		      <option value="0" {% if module_oop_categories_plus_subcats_products == 0 %} selected="selected" {% endif %}>{{ text_oop_subcats_products_category }}</option>
		      <option value="1" {% if module_oop_categories_plus_subcats_products == 1 %} selected="selected" {% endif %}>{{ text_oop_subcats_products_subcats }}</option>                
		</select>
	      </div>
	  </div>   
	  
	  <div class="form-group row mb-3">
	      <label class="col-sm-2 control-label" for="input-c2p-max_height">{{ text_oop_max_height }}</label>
	      <div class="col-sm-10">
		  <input type="text" name="module_oop_categories_plus_max_height" id="input-c2p-max_height" value="{{ module_oop_categories_plus_max_height }}" placeholder="{{ text_oop_max_height }}" id="input-c2p-max_height" class="form-control" />
	      </div>
	  </div>  	  
	  
	  <div class="form-group row mb-3">
	      <label class="col-sm-2 control-label" for="input-c2p-store">{{ text_oop_store }}</label>
	      <div class="col-sm-10">
		<select name="module_oop_categories_plus_store" id="input-c2p-store" class="form-control">
		      <option value="-1" {% if module_oop_categories_plus_store == -1 %} selected="selected" {% endif %}>{{ text_oop_store_all }}</option>
		      <option value="0" {% if module_oop_categories_plus_store == 0 %} selected="selected" {% endif %}>{{ text_oop_store_default }}</option>                
		      {% for store in stores %}
		      <option value="{{ store.store_id }}" {% if module_oop_categories_plus_store ==  store.store_id %} selected="selected" {% endif %}>{{ store.name }}</option>
		      {% endfor %}
		</select>
	      </div>
	  </div>        
        
          <div class="form-group row mb-3">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_oop_categories_plus_status" id="input-status" class="form-control">
                {% if module_oop_categories_plus_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$(function(){
  $('#input-c2p-display').on('change', function() {
      if($(this).val() == 1) {
	  $('#div-c2p-partially_opened').show();
      } else {
	  $('#div-c2p-partially_opened').hide();    
	  $('#input-c2p-partially_opened').val("");  
      }
  });  
});
//--></script>
{% else %}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-product').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <button type="button" id="btn_oop_prlist_save" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-default"><i class="fa fa-save"></i></button>
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="submit" form="form-product" formaction="{{ copy }}" data-toggle="tooltip" title="{{ button_copy }}" class="btn btn-default"><i class="fa fa-copy"></i></button>
        <button type="button" form="form-product" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-product').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">{% if error_warning %}
	<div class="alert alert-danger d-flex align-items-center" role="alert">
		<i class="far fa-exclamation-circle"></i>
		<div class="ps-3 pe-2">{{ error_warning }}</div>
		<button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
    {% endif %}
    {% if success %}
	<div class="alert alert-success alert-dismissible">
		<i class="far fa-check-circle"></i> {{ success }}
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
    {% endif %}
    <div class="row">

      <div class="col-md-3 col-sm-12" style="padding-right:0px;{% if module_oop_categories_plus_max_height != '' %}max-height:{{ module_oop_categories_plus_max_height }}px;overflow-y:scroll;{% endif %}">
<ul class="nav nav-tabs oop_nav_cat2pr" style="background-color:#f6f6f6;margin-bottom:0px;">
    <li {% if ooptab == 0 %} class="active" {% endif %} style="border:0px;">
        <a {% if ooptab == 0 %} class="active" {% endif %} href="#tab-category_list" data-toggle="tab" style="font-size:15px;line-height:22px;">
            <i class="fa fa-list" style="padding-right:7px;"></i> {{ text_category_list }}
        </a>
    </li>
    <li {% if ooptab %} class="active" {% endif %}>
        <a {% if ooptab %} class="active" {% endif %} href="#tab-filter" data-toggle="tab" style="font-size:15px;line-height:22px;">
            <i class="fa fa-filter" style="padding-right:7px;"></i> {{ text_filter }}
        </a>
    </li>
</ul>
     
        <div class="panel panel-default" style="border-top:0px;">
          <div class="panel-body tab-content">
	    <div id="tab-category_list" {% if ooptab == 0 %} class="tab-pane fade active in" {% else %} class="tab-pane fade" {% endif %}>
		
		{% macro cpitems(categories, categories_info, parts, oop_display, oop_opened, categories_ignore) %}
		
		
		    {% for key, category in categories %}
			<li ondrop="drop(event)" ondragover="allowDrop(event)" data-category_id="{{ key }}" class="plainlist">
			    <a style="width:100%;height:100%;" href="{{ categories_info[key].href }}"  {% if key in parts %} {% if key == parts | last %}  class="oop_cls_a_active" {% else %} class="oop_cls_a_prev_active"  {% endif %} {% endif %}>
				{% for i in 0 .. categories_info[key].level %}  {% if i %}  -  {% endif %} {% endfor %} {{ categories_info[key].name }}
				{% if category | length > 0 %} <div class="oop_cls_div_exp">{% if (key in parts) or ((oop_display == 1) and (oop_opened > 0) and (categories_info[key].level in range(0, oop_opened - 1))) or (oop_display == 2) %}-{% else %}+{% endif %}</div> {% endif %}
				{% if key == parts | last %}&nbsp;
				
				     <button id="oop_btn_cats" class="pull-right">
				            <svg width="24" height="24">
						  {% for cy in [7,12,17] %}
						      <circle cx="12" cy="{{ cy }}" r="1.4" stroke-width="4" fill="#7a7a7a" />
						  {% endfor %}
					    </svg>
					    <input type="hidden" value="{{ key }}" >
				     </button>
				{% endif %}
					
					{#
					<div class="form-check form-switch small-switch">
					  <input class="form-check-input qChangeIgnore" type="checkbox" id="qChangeIgnore{{ key }}" value="{{ categories_info[key].ignore_order }}" {% if categories_info[key].ignore_order %}checked{% endif %} data-categoryid="{{ key }}">
					  <label class="form-check-label" for="qChangeIgnore{{ key }}"></label>
					</div>		
					#}
			    </a>
			    
			    {% if category | length > 0 %}
				<ul {% if (key in parts) or ((oop_display == 1) and (oop_opened > 0) and (categories_info[key].level in range(0, oop_opened - 1))) or (oop_display == 2) %} style="display:block;" {% endif %}>
				    {{ _self.cpitems(category, categories_info, parts, oop_display, oop_opened) }}
				</ul>
			    {% endif %}
			</li>
		    {% endfor %}
		{% endmacro %}		
				
		<div id="oop_cls_div_cont">
		  <ul id="oop_ul_cats">
		    <li style="border:none;">
		      <ul style="display:block;">
			  {{ _self.cpitems(categories.categories, categories.categories_info, parts, oop_display, oop_opened) }}
		      </ul>
		    </li>
		  </ul>
		  <ul id="oop_ul_cats_menu" style="display:none;">
		      <li id="oop_cats_edit">{{ text_edit_cat }} <img class="pull-right" style="margin-top:3px;" src="data:image/png;base64," /></li>
		      <li id="oop_cats_add">{{ text_add_cat }} <img class="pull-right" style="margin-top:3px;" src="data:image/png;base64,"/></li>
		      <li id="oop_cats_del">{{ text_del_cat }} <img class="pull-right" style="margin-top:3px;" src="data:image/png;base64,"/></li>
		  </ul>
		</div>
		
		<form style="display: none"  action="{{ del_cat }}" method="post" id="frm-oop-del">
		      <input type="hidden" name="selected[]" value="" />
		</form>
		
		<form action="{{ action_frm_oop_c2p }}" method="post" id="frm-oop-c2p">
		      <div class="oop_cat_set">
			      <a href="#oop_collapse_ca_set" data-bs-toggle="collapse" class="parent mb-2 btn btn-secondary">
				    <i class="fa fa-cog fw"></i> {{ text_oop_settings }}
			      </a>
			      <ul id="oop_collapse_ca_set" class="collapse" style="list-style-type:none;margin:0px;padding:0 0 0 12px;">
				  <li>
				    <div class="form-group row mb-3 align-items-center">
					<label class="col-sm-4 control-label mb-0" for="input-c2p-display" style="font-weight:normal;">{{ text_oop_display_menu }}</label>
					<div class="col-sm-8">
					  <select name="module_oop_categories_plus_display" id="input-c2p-display" class="form-control">
						<option value="0" {% if module_oop_categories_plus_display == 0 %} selected="selected" {% endif %}>{{ text_oop_collapsed }}</option>
						<option value="1" {% if module_oop_categories_plus_display == 1 %} selected="selected" {% endif %}>{{ text_oop_partially_opened }}</option>                
						<option value="2" {% if module_oop_categories_plus_display == 2 %} selected="selected" {% endif %}>{{ text_oop_opened }}</option>
					  </select>
					</div>
				      </div>			    
				  </li>
				  <li>
				      <div id="div-c2p-partially_opened" class="form-group row mb-3 align-items-center" style="padding-top:0px;{% if module_oop_categories_plus_display == 1 %} display:flex; {% else %} display:none;  {% endif %}" >
					<label class="col-sm-4 control-label mb-0" for="input-c2p-partially_opened" style="font-weight:normal;">{{ text_oop_open_levels_count }}</label>
					<div class="col-sm-8">
					  <input type="text" name="module_oop_categories_plus_partially_opened" id="input-c2p-partially_opened" value="{{ module_oop_categories_plus_partially_opened }}" placeholder="{{ text_oop_open_levels_count }}" class="form-control">
					</div>
				      </div>			    
				  </li>	
				  <li>
				    <div class="form-group row mb-3 align-items-center" style="padding-top:0px;">
					<label class="col-sm-4 control-label mb-0" for="input-c2p-subcats_products" style="font-weight:normal;">{{ text_oop_subcats_products }}</label>
					<div class="col-sm-8">
					  <select name="module_oop_categories_plus_subcats_products" id="input-c2p-subcats_products" class="form-control">
						<option value="0" {% if module_oop_categories_plus_subcats_products == 0 %} selected="selected" {% endif %}>{{ text_oop_subcats_products_category }}</option>
						<option value="1" {% if module_oop_categories_plus_subcats_products == 1 %} selected="selected" {% endif %}>{{ text_oop_subcats_products_subcats }}</option>                
					  </select>
					</div>
				      </div>			    
				  </li>	
				  <li>
				      <div class="form-group row mb-3 align-items-center" style="padding-top:0px;">
					  <label class="col-sm-4 control-label mb-0" for="input-c2p-max_height"  style="font-weight:normal;">{{ text_oop_max_height }}</label>
					  <div class="col-sm-8">
					      <input type="text" name="module_oop_categories_plus_max_height" id="input-c2p-max_height" value="{{ module_oop_categories_plus_max_height }}" placeholder="{{ text_oop_max_height_ph }}" id="input-c2p-max_height" class="form-control" />
					  </div>
				      </div> 			    
				  </li>					  
				  <li>
				    <div class="form-group row mb-3 align-items-center" style="padding-top:0px;">
					<label class="col-sm-4 control-label mb-0" for="input-c2p-store" style="font-weight:normal;">{{ text_oop_store }}</label>
					<div class="col-sm-8">
					  <select name="module_oop_categories_plus_store" id="input-c2p-store" class="form-control">
						<option value="-1" {% if module_oop_categories_plus_store == -1 %} selected="selected" {% endif %}>{{ text_oop_store_all }}</option>
						<option value="0" {% if module_oop_categories_plus_store == 0 %} selected="selected" {% endif %}>{{ text_oop_store_default }}</option>                
						{% for store in stores %}
						<option value="{{ store.store_id }}" {% if module_oop_categories_plus_store ==  store.store_id %} selected="selected" {% endif %}>{{ store.name }}</option>
						{% endfor %}
					  </select>
					</div>
				      </div>			    
				  </li>					  
				  <li><button type="submit" form="frm-oop-c2p" id="button-oop-c2p-set" class="btn btn-primary pull-right"><i class="fa fa-save"></i>  {{ text_oop_apply_button }}</button></li>
			      </ul>
		      </div>
		      <input type="hidden" name="module_oop_categories_plus_status" value="{{ module_oop_categories_plus_status }}" />
		</form>
	    </div>
	    <div id="tab-filter" {% if ooptab %} class="tab-pane fade active in" {% else %} class="tab-pane fade" {% endif %}>
		<div class="panel panel-default border-0">
		  <div class="panel-body">
		    <div class="form-group row mb-3">
		      <label class="control-label" for="input-name">{{ entry_name }}</label>
		      <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
		    </div>
		    <div class="form-group row mb-3">
		      <label class="control-label" for="input-model">{{ entry_model }}</label>
		      <input type="text" name="filter_model" value="{{ filter_model }}" placeholder="{{ entry_model }}" id="input-model" class="form-control" />
		    </div>
		    <div class="form-group row mb-3">
		      <label class="control-label" for="input-price">{{ entry_price }}</label>
		      <input type="text" name="filter_price" value="{{ filter_price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control" />
		    </div>
		    <div class="form-group row mb-3">
		      <label class="control-label" for="input-quantity">{{ entry_quantity }}</label>
		      <input type="text" name="filter_quantity" value="{{ filter_quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="form-control" />
		    </div>
		    <div class="form-group row mb-3">
		      <label class="control-label" for="input-status">{{ entry_status }}</label>
		      <select name="filter_status" id="input-status" class="form-control">
			<option value=""></option>
			  {% if filter_status == '1' %}
			<option value="1" selected="selected">{{ text_enabled }}</option>
			  {% else %}
			<option value="1">{{ text_enabled }}</option>
			  {% endif %}
			  {% if filter_status == '0' %}
			<option value="0" selected="selected">{{ text_disabled }}</option>
			  {% else %}
			<option value="0">{{ text_disabled }}</option>
			  {% endif %}
		      </select>
		    </div>
		    <div class="form-group row text-right">
		      <button type="button" id="button-filter" class="btn btn-primary mt-2"><i class="fa fa-filter"></i> {{ button_filter }}</button>
		    </div>
		  </div>
		</div>	    
	    </div>
	  </div>
	</div>  
      </div>
      <div class="col-md-9 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
          </div>
          <div class="panel-body">
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-product">
              <div class="table-responsive">
                  
                  {% if products %}
<div class="product-list">
  {% if products %}
    {% for product in products %}
      <div id="product{{ product.product_id }}" class="product-row">
        <div class="product-col product-check">
          {% if product.product_id in selected %}
            <input type="checkbox" name="selected[]" value="{{ product.product_id }}" checked="checked" />
          {% else %}
            <input type="checkbox" name="selected[]" value="{{ product.product_id }}" />
          {% endif %}
        </div>
        <div class="product-col">
          {% if product.image %}
            <img data-current_category_id="{{ current_category_id }}" data-product_id="{{ product.product_id }}" src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" draggable="true" ondragstart="drag(event)" />
          {% else %}
            <span class="img-thumbnail list"><i class="fa fa-camera fa-2x"></i></span>
          {% endif %}
        </div>
        <div class="product-col product-name">
          <div class="cls-oop-div-text ">{{ product.name }}</div>
        </div>
        <div class="product-col product-model">
          <div class="cls-oop-div-text">{{ product.model }}</div>
        </div>
        <div class="product-col product-price">
          <div class="cls-oop-div-text">
            {% if product.special %}
              <span style="text-decoration: line-through;">{{ product.price }}</span><br/>
              <div class="text-danger">{{ product.special }}</div>
            {% else %}
              {{ product.price }}
            {% endif %}
          </div>
        </div>
        <div class="product-col product-quantity">
          <div class="cls-oop-div-text">
            {% if product.quantity <= 0 %}
              <span class="label label-warning">{{ product.quantity }}</span>
            {% elseif product.quantity <= 5 %}
              <span class="label label-danger">{{ product.quantity }}</span>
            {% else %}
              <span class="label label-success">{{ product.quantity }}</span>
            {% endif %}
          </div>
        </div>
        <div class="product-col product-status">
          <div class="cls-oop-div-text">{{ product.status }}</div>
        </div>
		<div class="product-bottom">
			<div class="product-col product-order">
			  <div class="cls-oop-div-text">
				<input type="text" class="form-control pull-right sort_order_input" value="{{ product.sort_order_ppc }}" />
			  </div>
			</div>
			<div class="product-col">
			  <a href="{{ product.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary">
				<i class="fa fa-pencil"></i>
			  </a>
			</div>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="product-row no-results text-center">
      <div class="product-col" colspan="9">{{ text_no_results }}</div>
    </div>
  {% endif %}
</div>

                  {% else %}
                  <tr>
                    <td class="text-center" colspan="9">{{ text_no_results }}</td>
                  </tr>
                  {% endif %}
                    </tbody>
              </div>
            </form>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript">
      $('#button-filter').on('click', function() {
	      var url = '';
		  
		  {% if catpath %}
			url += '&path=' + '{{ catpath }}';
		  {% endif %}
		  
	      var filter_name = $('input[name=\'filter_name\']').val();

	      if (filter_name) {
		      url += '&filter_name=' + encodeURIComponent(filter_name);
	      }

	      var filter_model = $('input[name=\'filter_model\']').val();

	      if (filter_model) {
		      url += '&filter_model=' + encodeURIComponent(filter_model);
	      }

	      var filter_price = $('input[name=\'filter_price\']').val();

	      if (filter_price) {
		      url += '&filter_price=' + encodeURIComponent(filter_price);
	      }

	      var filter_quantity = $('input[name=\'filter_quantity\']').val();

	      if (filter_quantity) {
		      url += '&filter_quantity=' + encodeURIComponent(filter_quantity);
	      }

	      var filter_status = $('select[name=\'filter_status\']').val();

	      if (filter_status !== '') {
		      url += '&filter_status=' + encodeURIComponent(filter_status);
	      }

	      url += '&ooptab=1';
	      
