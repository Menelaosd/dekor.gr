      $(function(){
	  $('#input-c2p-display').on('change', function() {
	      if($(this).val() == 1) {
		  $('#div-c2p-partially_opened').show();
	      } else {
		  $('#div-c2p-partially_opened').hide();    
		  $('#input-c2p-partially_opened').val("");  
	      }
	  });  

	  $("#oop_ul_cats .oop_cls_div_exp").click(function(e) {
	      e.preventDefault();
	      e.stopPropagation();
	      if($(this).html()=="+") { $(this).html("-"); } else { $(this).html("+"); }
	      var subli = $(this).closest("li").find('> ul');
	      if(subli.length) subli.slideToggle(200);
	  });
	  
	  $('#oop_btn_cats').click(function(e) {
	      e.preventDefault();
	      e.stopPropagation();   
	   
	      const rect = $("#oop_cls_div_cont")[0].getBoundingClientRect();    
	      const x = e.clientX - rect.left;
	      const y = e.clientY - rect.top;
	      $('#oop_ul_cats_menu').css({top: y, left: x});

	      $('#oop_ul_cats_menu').toggle();
	      if($('#oop_ul_cats_menu').is(":visible")) {
		  $('#oop_btn_cats').addClass('obc_active');		  
	      } else {
		  $('#oop_btn_cats').removeClass('obc_active');
	      }
	   
	  });  
	  
	  $(document).on("click", function(e){
	      if($("#oop_btn_cats") !== e.target && !$("#oop_btn_cats").has(e.target).length){
		  $('#oop_ul_cats_menu').hide();
		  $('#oop_btn_cats').removeClass('obc_active');
	      }            
	  });	 
	  
	  $('#oop_cats_edit').click(function(e) {
		location.href= '{{ edit_cat }}' + '&category_id=' + $('#oop_btn_cats input').val(); 
	  });
	  $('#oop_cats_add').click(function(e) {
		 location.href= '{{ add_cat }}'; 
	  });	
	  $('#oop_cats_del').click(function(e) {
	      if(confirm('Are you sure?')) {
		 $('#frm-oop-del input').val($('#oop_btn_cats input').val());
		 $('#frm-oop-del').submit();
	      } else {
	         return false;
	      }
	  });	  
      });
      
      function allowDrop(ev) {
	  ev.preventDefault();
      }      
      
      function drop(ev) {
	  ev.stopPropagation();  
	  ev.preventDefault();  
	  var category_id = $(ev.target).closest("li").data('category_id');   
	  var data = {};
	  try {
		data = JSON.parse(ev.dataTransfer.getData("text")); 
	  } catch (e) {
		return false;
	  }
	  $.post("{{ url_d2c }}", {current_category_id : data['current_category_id'], category_id : category_id, product_id : data['product_id']}, function(ret) {   
	      var arr_ret = JSON.parse(ret);    
	      if(arr_ret.resp == "ok") {   
		  location.reload();
	      }
	  });
      }      
      
      function drag(ev) {  
	  var data = {'current_category_id': $(ev.target).data('current_category_id'), 'product_id':$(ev.target).data('product_id')};	  
	  ev.dataTransfer.setData("text", JSON.stringify(data));
      }     
      
</script>
</div>
