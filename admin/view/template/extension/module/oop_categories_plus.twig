<script type="text/javascript">
$(document).ready(function() {
    $('.product-list').sortable({
        helper: function(e, ui) {
            ui.children().each(function() {
                $(this).width($(this).width());
            });
            return ui;
        },
		
        tolerance: "pointer", // Makes the snapping smoother
        revert: 200,
		
        placeholder: "sortable-placeholder",
        start: function(e, ui) {
            // Set placeholder height to match the dragged item
            ui.placeholder.height(ui.item.height());
            ui.item.addClass('dragging-item');
        },
        stop: function(e, ui) {
            ui.item.removeClass('dragging-item');
        },
        update: function(event, ui) {
            var col = 0;
            $('.product-list .product-row').each(function() {
                $(this).find(".sort_order_input").attr('value', col);
                $(this).find("span.sort_order_text").text(col);
                $(this).find("input[type='checkbox']").prop("checked", true).trigger("change");
                col++;
            });
        }
    }).disableSelection();
});

$('.qChangeIgnore').on('click', function(e) {
	var $master = $(this);
	var $category_id = $master.data('categoryid');
	var $newValue = $master.is(':checked') ? 1 : 0;

	$.ajax({
		url: "scripts/updatecategory_ignore.php",
		method: "POST",
		data: {id: $category_id, value: $newValue}
	}).done(function(response) {
		// Assuming response is successful
		if ($newValue === 1) {
			$master.removeClass('btn-default').addClass('btn-success');
		} else {
			$master.removeClass('btn-success').addClass('btn-default');
		}
	});
});

	
</script>

</script>

