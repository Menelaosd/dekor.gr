							<b>{{ product_seo_url.store }}</b><br>
							<div class="input-group" style="display:flex">
								<input type="text" value="{{ product_seo_url.2 }}" data-productid="{{ product.product_id }}" class="editSeoUrl">
								<button data-productid="{{ product.product_id }}" data-storeid="{{ product_seo_url.store_id }}" class="btn btn-primary updateSeoUrl">
									<i class="fa fa-check"></i>
								</button>
							</div>
						{% endfor %}
						</div>
					</td>
					
					<td class="text-left">
