						</div>
					</td>  
					
					{#
				  <td class="text-left">
				  <select name="{{ product.product_id }}_stock_status_id" id="{{ product.product_id }}_stock_status_id" class="editable"  onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");'>
                    {% for stock_status in stock_statuses %}
                    {% if stock_status.stock_status_id == product.stock_status_id %}
                    <option value="{{ stock_status.stock_status_id }}" selected="selected">{{ stock_status.name }}</option>
                     {% else %}
                    <option value="{{ stock_status.stock_status_id }}">{{ stock_status.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
				  </td>
				  #}
				  
