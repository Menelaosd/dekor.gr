                    {% elseif product.quantity <= 5 %}
					<input type="text" class="editable label-danger" name="{{ product.product_id }}_quantity" id="{{ product.product_id }}_quantity" value="{{ product.quantity }}" size="3" onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");' />
                    {% else %}
                    <input type="text" class="editable label-success" name="{{ product.product_id }}_quantity" id="{{ product.product_id }}_quantity" value="{{ product.quantity }}" size="3" onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");' />
                    {% endif %}
					</td>
                    <td class="text-left">
{{ product.status }}					
	<select name="{{ product.product_id }}_status" id="{{ product.product_id }}_status" onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");'> 
                    {% if product.status == text_enabled %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
    </select>
	
	
					<br />id: {{ product.product_id }}
					</td>
					
                    <td class="text-left">
						<div class="input-group input-group-weight mb-3">
						  <input type="text" class="form-control editWeight" value="{{ product.weight }}" data-productid="{{ product.product_id }}" aria-label="Recipient's username">
						  <div class="input-group-append">
							<button class="btn btn-primary editWeighBtn" data-productid="{{ product.product_id }}" type="button"><i class="fa fa-save"></i></button>
						  </div>
						</div>
					</td>                  
					<td class="text-left">
						<div class="input-group input-group-package mb-3">
						  <input type="text" class="form-control editPackage" value="{{ product.package }}" data-productid="{{ product.product_id }}" aria-label="Recipient's username">
						  <div class="input-group-append">
							<button class="btn btn-primary editPackageBtn" data-productid="{{ product.product_id }}" type="button"><i class="fa fa-save"></i></button>
						  </div>
						</div>
					</td>
                    <td class="text-right">
					<a href="{{ product.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
					</td>
                  </tr>
                  {% endfor %}
                  {% else %}
                  <tr>
                    <td class="text-center" colspan="10">{{ text_no_results }}</td>
                  </tr>
                  {% endif %}
                    </tbody>
                  
                </table>
              </div>
            </form>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript">
	$('.qChangeOrderBtn').on('click',function(e){
		var $master = $(this);
		var $product_id = $(this).data('productid');
		var $value = $(this).siblings('.qChangeOrder').val();
		e.preventDefault();
		$.ajax({
		url: "scripts/updateproduct.php",
		method: "POST",
		data: {id:$product_id,value:$value}
	  }).success(function(response) {
		$master.removeClass('btn-success').addClass('btn-success');
	  });
	});
	
	$('.editWeighBtn').on('click',function(e){
		var $master = $(this);
		var $mastercon = $(this).closest('tr');
		var $product_id = $(this).data('productid');
		var $value = $mastercon.find('.editWeight').val();
		e.preventDefault();
		$.ajax({
		url: "scripts/updateproductweight.php",
		method: "POST",
		data: {id:$product_id,value:$value}
	  }).success(function(response) {
		$master.removeClass('btn-success').addClass('btn-success');
	  });
	});
	
	$('.editPackageBtn').on('click',function(e){
		var $master = $(this);
		var $mastercon = $(this).closest('tr');
		var $product_id = $(this).data('productid');
		var $value = $mastercon.find('.editPackage').val();
		e.preventDefault();
		$.ajax({
		url: "scripts/updateproductpackage.php",
		method: "POST",
		data: {id:$product_id,value:$value}
	  }).success(function(response) {
		$master.removeClass('btn-success').addClass('btn-success');
	  });
	});
	

	$('.updateSeoUrl').on('click',function(e){
		var $master = $(this);
		var $mastercon = $(this).closest('.input-group');
		var $product_id = $(this).data('productid');
		var $store_id = $(this).data('storeid');
		var $value = $mastercon.find('.editSeoUrl').val();

		e.preventDefault();
		$.ajax({
			url: "scripts/update_seourl.php",
			method: "POST",
			data: {id:$product_id,store_id:$store_id,value:$value}
		}).success(function(response) {
			$master.removeClass('btn-success').addClass('btn-success');
		});
	});
	
</script> 
<style type="text/css">
.input-group-weight {
	display:flex;
}

.input-group-package {
	display:flex;
}

input.form-control.editWeight {
	min-width:100px;
}
</style>

  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = '';

	var filter_name = $('input[name=\'filter_name\']').val();

	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_model = $('input[name=\'filter_model\']').val();

	if (filter_model) {
		url += '&filter_model=' + encodeURIComponent(filter_model);
	}

	var filter_price = $('input[name=\'filter_price\']').val();

	if (filter_price) {
		url += '&filter_price=' + encodeURIComponent(filter_price);
	}

  var filter_xml = $('select[name=\'filter_xml\'] option:selected').val();

  if (filter_xml) {
    url += '&filter_xml=' + encodeURIComponent(filter_xml);
  }

  var filter_manufacturer = $('select[name=\'filter_manufacturer\']').val();

  if (filter_manufacturer) {
    url += '&filter_manufacturer=' + encodeURIComponent(filter_manufacturer);
  }

	var filter_category = $('select[name=\'filter_category\']').val();    		
    if (filter_category != '*') {
		url += '&filter_category=' + encodeURIComponent(filter_category);
	}

	var filter_quantity = $('input[name=\'filter_quantity\']').val();

	if (filter_quantity) {
		url += '&filter_quantity=' + encodeURIComponent(filter_quantity);
	}

  var filter_status = $('select[name=\'filter_status\']').val();

  if (filter_status !== '') {
    url += '&filter_status=' + encodeURIComponent(filter_status);
  }
  
  var filter_noimage = $('select[name=\'filter_noimage\']').val();

  if (filter_noimage !== '') {
    url += '&filter_noimage=' + encodeURIComponent(filter_noimage);
  }

	location = 'index.php?route=catalog/product&user_token={{ user_token }}' + url;
});
