					</td>
                    <td class="text-left">
					<textarea name="{{ product.product_id }}_model" class="editable" id="{{ product.product_id }}_model" onClick="document.getElementById(&quot;{{ product.product_id }}_select&quot;).setAttribute(&quot;checked&quot;,&quot;checked&quot;);" cols="10">{{ product.model }}</textarea></td>

					
