                    <div class="text-danger">    
	  {{ column_spec }} :<br><input type="text" class="editable" name="{{ product.product_id }}_special" id="{{ product.product_id }}_special" value="{{ product.special }}" size="8" onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");' />
		</div>
                    {% else %}
                    <input type="text" class="editable" name="{{ product.product_id }}_price" id="{{ product.product_id }}_price" value="{{ product.price }}" size="8" onclick='document.getElementById("{{ product.product_id }}_select").setAttribute("checked","checked");' />
                    {% endif %}
					  </td>
                    <td class="text-right">
				  {% if product.quantity <= 0 %}
