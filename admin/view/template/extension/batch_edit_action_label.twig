<h4>{{ tab_action_label }}</h4>
<hr/>
{% set col1 = '2' %}
{% set col2 = '2' %}
{% set col3 = '4' %}
{% set col4 = '4' %}
<div class="row form-row">
	<div class="toggle-caption"><h4>{{ text_update_existing }}</h4><button type="button" onclick="" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger btn-clone-clear"><i class="fa fa-trash-o"></i></button></div>
</div>
<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[label][update][---0---][label_id]"><i class="required"></i> {{ entry_label }}</label>
				<div class="col-sm-8">
					<input type="text" value="" placeholder="{{ entry_label }}" id="action[label][update][---0---][label_id]" data-target="action[label][update][---0---][label_id]" class="form-control label-select" />
					<input type="hidden" name="action[label][update][---0---][label_id]" value="" />
				</div>
				<div class="col-sm-2 hide-filter">
					<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
					<button type="button" onclick="if (!$(this).closest('.form-group').hasClass('clone-master')) { bpe.hideFilter(this); } else { $(this).closest('.form-group').find('input, select').val(''); }" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
				</div>
			</div>
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[label][update][---0---][store_id]"><i class="required"></i> {{ entry_store }}</label>
				<div class="col-sm-10">
					<select id="action[label][update][---0---][store_id]" name="action[label][update][---0---][store_id]" class="form-control">
						<option value="">{{ text_all }}</option>
						{% for store in stores %}
						<option value="{{ store.store_id }}">{{ store.name }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[label][update][---0---][date_start]">{{ entry_date_available }}</label>
				<div class="col-sm-4">
					<div class="input-group date">
						<input type="text" name="action[label][update][---0---][date_start]" value="" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" data-locale="{{ datepicker }}" id="action[label][update][---0---][date_start]" class="form-control" />
						<div class="input-group-btn">
							<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
						</div>
					</div>
				</div>
				<label class="col-sm-2 control-label" for="action[label][update][---0---][date_end]" style="text-align:center;"><i class="fa fa-minus"></i></label>
				<div class="col-sm-4">
					<div class="input-group date">
						<input type="text" name="action[label][update][---0---][date_end]" value="" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" data-locale="{{ datepicker }}" id="action[label][update][---0---][date_end]" class="form-control" />
						<div class="input-group-btn">
							<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
