<h4>{{ tab_action_clear }}</h4>
<hr/>
<div class="form-group action-group-default">
	<div class="col-sm-12">
		<div class="checkbox">
			<label><input name="action[clear][products]" type="checkbox" value="1"> {{ entry_clear_products }}</label>
		</div>
	</div>
</div>
<div class="form-group action-group-default">
	<div class="col-sm-12">
		<div class="checkbox">
			<label><input name="action[clear][specials]" type="checkbox" value="1"> {{ entry_clear_specials }}</label>
		</div>
	</div>
</div>
<div class="form-group action-group-default">
	<div class="col-sm-12">
		<div class="checkbox">
			<label><input name="action[clear][discounts]" type="checkbox" value="1"> {{ entry_clear_discounts }}</label>
		</div>
	</div>
</div>
<div class="form-group action-group-default">
	<div class="col-sm-12">
		<div class="checkbox">
			<label><input name="action[clear][options]" type="checkbox" value="1"> {{ entry_clear_options }}</label>
		</div>
	</div>
</div>
<div class="form-group action-group-default">
	<div class="col-sm-12">
		<div class="checkbox">
			<label><input name="action[clear][attributes]" type="checkbox" value="1"> {{ entry_clear_attributes }}</label>
		</div>
	</div>
</div>
{% if oc_filters %}
<div class="form-group action-group-default">
	<div class="col-sm-12">
