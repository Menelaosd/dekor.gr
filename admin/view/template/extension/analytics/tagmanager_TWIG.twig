					<div id="div-refund-{{ trans.id }}" data-loading-text="loading" onclick="refundorder({{ trans.order_id }},{{ trans.id }});"  class="btn btn-primary" {% if trans.hit != "1" %} disabled {% endif %}><i class="fa fa-plus-circle"></i> {{ button_refund }}</div>
				</td>
				</tr>
