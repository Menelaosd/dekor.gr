				</div>

				<div class="col-sm-2 hide-filter">
					<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
					<button type="button" onclick="if (!$(this).closest('div.form-group').hasClass('clone-master')) { bpe.hideFilter(this); } else { $(this).closest('div.form-group').find('input, select, textarea').not('.no-clean').val(''); }" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
				</div>
			</div>
			<div class="row form-row option-value-id hidden">
				<label class="col-sm-{{ col1 }} control-label">{{ entry_price }}</label>
				<div class="col-sm-{{ col2 }}">
					<select name="action[option][update][---0---][price][sign]" class="form-control">
						<option value="-">-</option>
						<option value="+">+</option>
						<option value="*">*</option>
						<option value="/">/</option>
						<option value="=">=</option>
					</select>
				</div>
				<div class="col-sm-{{ col3 }}">
					<input type="text" name="action[option][update][---0---][price][value]" value="" placeholder="0.00" class="form-control" />
