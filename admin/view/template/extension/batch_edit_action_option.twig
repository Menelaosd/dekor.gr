<div class="row form-row">
	<div class="toggle-caption"><h4>{{ text_update_existing }}</h4><button type="button" onclick="" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger btn-clone-clear"><i class="fa fa-trash-o"></i></button></div>
</div>
<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<div class="row form-row">
				<div class="col-sm-5">
					<div class="row form-row ">
						<label class="col-sm-5 control-label" for="action[option][update][---0---][option_id]"><i class="required"></i> {{ entry_option }} <span data-toggle="tooltip" title="{{ help_option }}"></span></label>
						<div class="col-sm-7">
							<input type="text" value="" placeholder="{{ entry_option }}" id="action[option][update][---0---][option_id]" data-target="action[option][update][---0---][option_id]" data-target-values="action[option][update][---0---][option_value_id]" class="form-control option-select" />
							<input type="hidden" name="action[option][update][---0---][option_id]" value="" />
						</div>
					</div>

					<div class="row form-row option-value-text option-value-file hidden">
						<label class="col-sm-5 control-label" for="action[option][update][---0---][value_text_required]">{{ entry_required }}</label>
						<div class="col-sm-7">
							<select name="action[option][update][---0---][value_text_required]" class="form-control" title="{{ entry_required }}" data-toggle="tooltip">
								<option value=""></option>
								<option value="0">{{ entry_required }} - {{ text_no }}</option>
								<option value="1">{{ entry_required }} - {{ text_yes }}</option>
							</select>
						</div>
					</div>
				</div>

				<!-- option_value_none -->
				<div class="col-sm-2 option-value-none"></div>
				<div class="col-sm-3 option-value-none"></div>
				<!-- option_value_id -->
				<label class="col-sm-2 control-label option-value-id hidden" for="action[option][update][---0---][option_value_id]">{{ entry_option_value }} <span data-toggle="tooltip" title="{{ help_option_value }}"></span></label>
