<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<label class="col-sm-2 control-label" for="action[option][delete][---0---][option_id]"><i class="required"></i> {{ entry_option }}</label>
			<div class="col-sm-3">
				<input type="text" value="" placeholder="{{ entry_option }}" id="action[option][delete][---0---][option_id]" data-target="action[option][delete][---0---][option_id]" data-target-values="action[option][delete][---0---][option_value_id]" class="form-control option-select" />
				<input type="hidden" name="action[option][delete][---0---][option_id]" value="" />
			</div>
			<label class="col-sm-2 control-label" for="action[option][delete][---0---][option_value_id]">{{ entry_option_value }}</label>
			<div class="col-sm-3">
				<select name="action[option][delete][---0---][option_value_id]" id="action[option][delete][---0---][option_value_id]" class="form-control">
