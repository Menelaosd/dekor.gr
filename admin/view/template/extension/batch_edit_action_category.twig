<h4>{{ tab_action_category }}</h4>
<hr/>
<div class="row form-row">
	<div class="toggle-caption"><h4>{{ text_add_new }}</h4><button type="button" onclick="" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger btn-clone-clear"><i class="fa fa-trash-o"></i></button></div>
</div>
<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<label class="col-sm-2 control-label" for="action[category][insert][---0---][category_id]"><i class="required"></i> {{ entry_category }}</label>
			<div class="col-sm-8">
				<input type="text" value="" placeholder="{{ entry_category }}" id="action[category][insert][---0---][category_id]" data-target="action[category][insert][---0---][category_id]" class="form-control category-select" />
				<input type="hidden" name="action[category][insert][---0---][category_id]" value="" />
			</div>
			<div class="col-sm-2 hide-filter">
				<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
				<button type="button" onclick="if (!$(this).parent().parent().hasClass('clone-master')) { bpe.hideFilter(this); } else { $(this).parent().parent().find('input').val(''); }" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
			</div>
		</div>
	</div>
</div>
<div class="row form-row">
	<div class="toggle-caption"><h4>{{ text_remove_existing }}</h4><button type="button" onclick="" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger btn-clone-clear"><i class="fa fa-trash-o"></i></button></div>
</div>
<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<label class="col-sm-2 control-label" for="action[category][delete][---0---][category_id]"><i class="required"></i> {{ entry_category }}</label>
			<div class="col-sm-8">
				<input type="text" value="" placeholder="{{ entry_category }}" id="action[category][delete][---0---][category_id]" data-target="action[category][delete][---0---][category_id]" class="form-control category-select" />
				<input type="hidden" name="action[category][delete][---0---][category_id]" value="" />
			</div>
			<div class="col-sm-2 hide-filter">
				<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
				<button type="button" onclick="if (!$(this).parent().parent().hasClass('clone-master')) { bpe.hideFilter(this); } else { $(this).parent().parent().find('input').val(''); }" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
			</div>
		</div>
	</div>
</div>