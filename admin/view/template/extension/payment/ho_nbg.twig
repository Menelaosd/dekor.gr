{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
					<ul class="nav nav-tabs">
						<li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
						<li><a href="#tab-debug" data-toggle="tab">{{ tab_debug }}</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="tab-general">
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-merchant_name"><span data-toggle="tooltip" title="{{ help_from_nbg }}">{{ entry_merchant_name }}</span></label>
								<div class="col-sm-10">
									<input type="text" id="input-merchant_name" name="payment_ho_nbg_merchant_name" value="{{ payment_ho_nbg_merchant_name }}" placeholder="{{ entry_payment_ho_nbg_merchant_name }}" size="80" class="form-control">
								</div>
							</div>
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-client"><span data-toggle="tooltip" title="{{ help_from_nbg }}">{{ entry_client }}</span></label>
								<div class="col-sm-10">
									<input type="text" id="input-client" name="payment_ho_nbg_client" value="{{ payment_ho_nbg_client }}" placeholder="{{ entry_payment_ho_nbg_client }}" size="80" class="form-control">
								</div>
							</div>
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-password"><span data-toggle="tooltip" title="{{ help_from_nbg }}">{{ entry_password }}</span></label>
								<div class="col-sm-10">
									<input type="text" id="input-password" name="payment_ho_nbg_password" value="{{ payment_ho_nbg_password }}" placeholder="{{ entry_payment_ho_nbg_password }}" size="80" class="form-control">
								</div>
							</div>
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-merchant_id"><span data-toggle="tooltip" title="{{ help_from_nbg }}">{{ entry_merchant_id }}</span></label>
								<div class="col-sm-10">
									<input type="text" id="input-merchant_id" name="payment_ho_nbg_merchant_id" value="{{ payment_ho_nbg_merchant_id }}" placeholder="{{ entry_payment_ho_nbg_merchant_id }}" size="80" class="form-control">
								</div>
							</div>
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-pageid"><span data-toggle="tooltip" title="{{ help_from_nbg }}">{{ entry_pageid }}</span></label>
								<div class="col-sm-10">
									<input type="text" id="input-pageid" name="payment_ho_nbg_pageid" value="{{ payment_ho_nbg_pageid }}" placeholder="{{ entry_payment_ho_nbg_pageid }}" class="form-control">
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-total"><span data-toggle="tooltip" title="{{ help_total }}">{{ entry_total }}</span></label>
								<div class="col-sm-10">
									<input type="text" name="payment_ho_nbg_total" value="{{ payment_ho_nbg_total }}" placeholder="{{ entry_total }}" id="input-total" class="form-control" />
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-testmode">{{ entry_testmode }}</label>
								<div class="col-sm-10">
									<select name="payment_ho_nbg_status" id="input-testmode" class="form-control">
										{% if payment_ho_nbg_status %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
								</div>
							</div>						
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-order-status">{{ entry_order_status }}</label>
								<div class="col-sm-10">
									<select name="payment_ho_nbg_order_status_id" id="input-order-status" class="form-control">
									{% for order_status in order_statuses %}
										{% if order_status.order_status_id == payment_ho_nbg_order_status_id %}
											<option value="{{ order_status.order_status_id }}" selected="selected">{{ order_status.name }}</option>
										{% else %}
											<option value="{{ order_status.order_status_id }}">{{ order_status.name }}</option>
										{% endif %}
									{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-geo-zone">{{ entry_geo_zone }}</label>
								<div class="col-sm-10">
									<select name="payment_ho_nbg_geo_zone_id" id="input-geo-zone" class="form-control">
									<option value="0">{{ text_all_zones }}</option>
									{% for geo_zone in geo_zones %}
										{% if geo_zone.geo_zone_id == payment_ho_nbg_geo_zone_id %}
											<option value="{{ geo_zone.geo_zone_id }}" selected="selected">{{ geo_zone.name }}</option>
										{% else %}
											<option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name }}</option>
										{% endif %}
									{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="payment_ho_nbg_status" id="input-status" class="form-control">
										{% if payment_ho_nbg_status %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="sort_order">{{ entry_sort_order }}</label>
								<div class="col-sm-10">
									<input type="text" name="payment_ho_nbg_sort_order" value="{{ payment_ho_nbg_sort_order }}" placeholder="" id="sort_order" class="form-control">
								</div>
							</div>
						</div>
						<div class="tab-pane" id="tab-debug">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_debug }}</label>
								<div class="col-sm-10">
									<select name="payment_ho_nbg_debug" id="input-status" class="form-control">
										{% if payment_ho_nbg_debug %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_debug_file }}</label>
								<div class="col-sm-10">
									<textarea cols="100" rows="20" class="form-control" readonly>{{ debug_text }}</textarea>
								</div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}