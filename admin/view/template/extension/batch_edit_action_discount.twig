<h4>{{ tab_action_discount }}</h4>
<hr/>
{% set col1 = '2' %}
{% set col2 = '3' %}
{% set col3 = '2' %}
{% set col4 = '2' %}
{% set col5 = '3' %}
<div class="row form-row">
	<div class="toggle-caption"><h4>{{ text_update_existing }}</h4><button type="button" onclick="" data-toggle="tooltip" title="{{ button_clear }}" class="btn btn-danger btn-clone-clear"><i class="fa fa-trash-o"></i></button></div>
</div>
<div class="toggle">
	<div class="clone-wr">
		<div class="form-group action-group-default clone-master">
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[discount][update][---0---][customer_group_id]"><i class="required"></i> {{ entry_customer_group }}</label>
				<div class="col-sm-8">
					<select name="action[discount][update][---0---][customer_group_id]" id="action[discount][update][---0---][customer_group_id]" class="form-control">
						<option value="0">{{ text_all }}</option>
						{% for customer_group in customer_groups %}
						<option value="{{ customer_group.customer_group_id }}">{{ customer_group.name }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="col-sm-2 hide-filter">
					<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
					<button type="button" onclick="if (!$(this).parent().parent().parent().hasClass('clone-master')) { bpe.hideFilter(this); } else { $(this).parent().parent().parent().find('input[type=text], input[type=hidden], select, textarea').val(''); }" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
				</div>
			</div>
			<div class="row form-row">
				<label class="col-sm-{{ col1 }} control-label"><i class="required"></i> {{ entry_price }}</label>
				<div class="col-sm-{{ col2 }}">
					<select name="action[discount][update][---0---][sign]" class="form-control">
						<option value="-">-</option>
						<option value="+">+</option>
						<option value="*">*</option>
						<option value="/">/</option>
						<option value="=">=</option>
					</select>
				</div>
				<div class="col-sm-{{ col3 }}">
					<input type="text" name="action[discount][update][---0---][price]" value="" placeholder="0.00" class="form-control" />
				</div>
				<div class="col-sm-{{ col4 + col5 }}">
					<select name="action[discount][update][---0---][type]" class="form-control">
						<option value="pp">{{ text_percent_product }}</option>
						<option value="fp">{{ text_fixed_product }}</option>
						<option value="p">{{ text_percent }}</option>
						<option value="f">{{ text_fixed }}</option>
					</select>
				</div>
			</div>
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[discount][update][---0---][quantity]">{{ entry_quantity }}</label>
				<div class="col-sm-4">
					<input type="text" name="action[discount][update][---0---][quantity]" id="action[discount][update][---0---][quantity]" value="" placeholder="0" class="form-control" />
				</div>
				<label class="col-sm-2 control-label" for="action[discount][update][---0---][priority]">{{ entry_priority }}</label>
				<div class="col-sm-4">
					<input type="text" name="action[discount][update][---0---][priority]" id="action[discount][update][---0---][priority]" value="" placeholder="0" class="form-control" />
				</div>
			</div>
			<div class="row form-row">
				<label class="col-sm-2 control-label" for="action[discount][update][---0---][date_start]">{{ entry_date_available }}</label>
				<div class="col-sm-4">
					<div class="input-group date">
						<input type="text" name="action[discount][update][---0---][date_start]" value="" placeholder="{{ entry_date_start }}" data-date-format="YYYY-MM-DD" data-locale="{{ datepicker }}" id="action[discount][update][---0---][date_start]" class="form-control" />
						<div class="input-group-btn">
							<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
						</div>
					</div>
				</div>
				<label class="col-sm-2 control-label" for="action[discount][update][---0---][date_end]" style="text-align:center;"><i class="fa fa-minus"></i></label>
				<div class="col-sm-4">
					<div class="input-group date">
						<input type="text" name="action[discount][update][---0---][date_end]" value="" placeholder="{{ entry_date_end }}" data-date-format="YYYY-MM-DD" data-locale="{{ datepicker }}" id="action[discount][update][---0---][date_end]" class="form-control" />
						<div class="input-group-btn">
							<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
