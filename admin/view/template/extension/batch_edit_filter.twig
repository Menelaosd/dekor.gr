<div class="pull-right dropdown" style="padding-bottom:5px;">
	<button type="button" id="button-filter" data-toggle="tooltip" title="{{ button_preview_filter }}" class="btn btn-primary" onclick="$('.nav a[href=\'#tab_action_preview\']').click();" style="padding: 5px 13px;"><i class="fa fa-filter"></i> {{ button_preview_filter }}</button>
	<button type="button" data-toggle="dropdown" title="{{ button_add_filter }}" class="btn btn-primary dropdown-toggle btn-filter-field" style="padding: 5px 13px;"><i class="fa fa-plus"></i>&nbsp;<span class="caret"></span></button>
	<ul class="dropdown-menu">
		<li><a data-filter_field="store_id">{{ entry_store }}</a></li>
		<li><a data-filter_field="language_id">{{ entry_language }}</a></li>
		<li class="divider"></li>
		{% for field in text_fields %}
		<li><a data-filter_field="{{ field.input }}">{{ field.label }}</a></li>
		{% endfor %}
		<li class="divider"></li>
		{% if oc_filter %}
		<li><a data-filter_field="filters">{{ column_filter }}</a></li>
		{% endif %}
		<li><a data-filter_field="categories">{{ entry_category }}</a></li>
		<li><a data-filter_field="manufacturers">{{ entry_manufacturer }}</a></li>
		<li><a data-filter_field="options">{{ column_option }}</a></li>
		<li><a data-filter_field="attributes">{{ column_attribute }}</a></li>
		{% if ext_labels %}
		<li><a data-filter_field="labels">{{ tab_labels }}</a></li>
		{% endif %}
		<li><a data-filter_field="date_available">{{ entry_date_available }}</a></li>
		<li><a data-filter_field="date_added">{{ entry_date_added }}</a></li>
		<li><a data-filter_field="date_modified">{{ entry_date_modified }}</a></li>
		<li><a data-filter_field="status">{{ entry_status }}</a></li>
		<li><a data-filter_field="sort_order">{{ entry_sort_order }}</a></li>
		<li><a data-filter_field="price">{{ entry_price }}</a></li>
		<li><a data-filter_field="special">{{ column_special }}</a></li>
		<li><a data-filter_field="discount">{{ column_discount }}</a></li>
		<li><a data-filter_field="tax_class_id">{{ entry_tax_class }}</a></li>
		<li><a data-filter_field="quantity">{{ entry_quantity }}</a></li>
		<li><a data-filter_field="minimum">{{ entry_minimum }}</a></li>
		<li><a data-filter_field="subtract">{{ entry_subtract }}</a></li>
		<li><a data-filter_field="stock_status_id">{{ entry_stock_status }}</a></li>
		<li><a data-filter_field="shipping">{{ entry_shipping }}</a></li>
		<li><a data-filter_field="points">{{ entry_points }}</a></li>
		<li><a data-filter_field="weight_class_id">{{ entry_weight_class }}</a></li>
		<li><a data-filter_field="weight">{{ entry_weight }}</a></li>
		<li><a data-filter_field="length_class_id">{{ entry_length_class }}</a></li>
		<li><a data-filter_field="length">{{ entry_length }}</a></li>
		<li><a data-filter_field="width">{{ entry_width }}</a></li>
		<li><a data-filter_field="height">{{ entry_height }}</a></li>
		<li><a data-filter_field="seo_url">{{ entry_seo_url }}</a></li>
		{% if custom_fields %}
		<li class="divider"></li>
		{% for field in custom_fields %}
		<li><a data-filter_field="custom-{{ field.input }}">{{ field.label }}</a></li>
		{% endfor %}
		{% endif %}
		<li class="divider"></li>
		<li><a data-filter_field="sql">{{ tab_action_sql }}</a></li>
	</ul>
</div>
<h4>{{ text_filters }}</h4>
<hr/>
{% set col1 = '3' %}
{% set col2 = '7' %}
{% set col3 = '2' %}
<div class="form-group filter-group-filter_layout filter-group-default">
	<label class="col-sm-{{ col1 }} control-label" for="filter[filter_layout][name]">{{ entry_editor_layout }}</label>
	<div class="col-sm-{{ col2 }}">
		<!-- <select name="filter[filter_layout]" id="filter[filter_layout]" class="form-control" onchange="bpe.loadLayout(this);">
		</select> -->
		<input type="text" value="" placeholder="{{ entry_editor_layout_name }}" name="filter[filter_layout][name]" id="filter[filter_layout][name]" class="form-control filter-layout-select" data-target="filter[filter_layout][id]" />
		<input type="hidden" name="filter[filter_layout][id]" id="filter[filter_layout][id]" value="" />
		<input type="hidden" name="filter[filter_layout][data]" id="filter[filter_layout][data]" value="" />
	</div>
	<div class="col-sm-{{ col3 }} hide-filter">
	<button type="button" onclick="bpe.saveLayout(this);" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
	<button type="button" onclick="bpe.deleteLayout(this);" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-warning"><i class="fa fa-trash-o"></i></button>
	</div>
</div>
{% set col1 = '3' %}
{% set col2 = '8' %}
{% set col3 = '1' %}
<div class="form-group filter-group-store_id">
	<label class="col-sm-{{ col1 }} control-label" for="filter[store_id]">{{ entry_store }}</label>
	<div class="col-sm-{{ col2 }}">
		<select name="filter[store_id]" id="filter[store_id]" class="form-control">
			<option value="">{{ text_all }}</option>
			{% for store in stores %}
			<option value="{{ store.store_id }}">{{ store.name }}</option>
			{% endfor %}
		</select>
	</div>
	<div class="col-sm-{{ col3 }} hide-filter">
	<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
	</div>
</div>
<div class="form-group filter-group-language_id">
	<label class="col-sm-{{ col1 }} control-label" for="filter[language_id]">{{ entry_language }}</label>
	<div class="col-sm-{{ col2 }}">
		<select name="filter[language_id]" id="filter[language_id]" class="form-control">
			<option value="">{{ text_all }}</option>
			{% for language in languages %}
			<option value="{{ language.language_id }}">{{ language.name }}</option>
			{% endfor %}
		</select>
	</div>
	<div class="col-sm-{{ col3 }} hide-filter"><button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></div>
</div>
{% for field in text_fields %}
<div class="form-group filter-group-{{ field.input }}{% if field.default %} filter-group-default{% endif %}">
	<label class="col-sm1-{{ col1 }} col-sm-12 col-md-12 col-lg-3 control-label" for="filter[{{ field.input }}]">{{ field.label }}</label>
	<div class="col-sm1-{{ col2 }} col-sm-10 col-md-10 col-lg-8">
		<input type="text" name="filter[{{ field.input }}]" value="" placeholder="{{ field.label }}" id="filter[{{ field.input }}]" class="form-control" />
		<div class="row form-row">
			<div class="btn-group" data-toggle="buttons">
				<label class="btn btn-default active" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').show();">
				<input name="filter[{{ field.input }}_contains]" value="contains" checked="checked" type="radio">{{ entry_contains }}
				</label>
				<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
				<input name="filter[{{ field.input }}_contains]" value="starts" type="radio">{{ entry_starts }}
				</label>
				<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
				<input name="filter[{{ field.input }}_contains]" value="ends" type="radio">{{ entry_ends }}
				</label>
				<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
				<input name="filter[{{ field.input }}_contains]" value="empty" type="radio">{{ entry_empty }}
				</label>
			</div>
			&nbsp;&nbsp;
			<div class="btn-group filter-{{ field.input }}-condition" data-toggle="buttons">
				<label class="btn btn-default active" data-toggle="tooltip" title="{{ info_or }}">
				<input name="filter[{{ field.input }}_or]" value="and" checked="checked" type="radio">{{ entry_and }}
				</label>
				<label class="btn btn-default" data-toggle="tooltip" title="{{ info_or }}">
				<input name="filter[{{ field.input }}_or]" value="or" type="radio">{{ entry_or }}
				</label>
				<label class="btn btn-default" data-toggle="tooltip" title="{{ info_or }}">
				<input name="filter[{{ field.input }}_or]" value="equal" type="radio">{{ entry_equal }}
				</label>
			</div>
		</div>
	</div>
	<div class="col-sm1-{{ col3 }} col-sm-2 col-md-2 col-lg-1 hide-filter">
	<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
	</div>
</div>
{% endfor %}
<div class="clone-wr">
	<div class="form-group filter-group-categories clone-master filter-group-default">
		<label class="col-sm-{{ col1 }} control-label" for="filter[categories][---0---][category_id]">{{ entry_category }}</label>
		<div class="col-sm-{{ col2 - col3 }}">
			<input type="text" value="" placeholder="{{ entry_category }}" id="filter[categories][---0---][category_id]" class="form-control category-select" data-target="filter[categories][---0---][category_id]" data-na="1" />
			<input type="hidden" name="filter[categories][---0---][category_id]" value="" />
			<div class="checkbox">
				<label><input name="filter[categories][---0---][sub_category]" type="checkbox" value="1"> {{ entry_category_sub }}</label>
			</div>
		</div>
		<div class="col-sm-{{ col3 + col3 }} hide-filter">
			<button type="button" onclick="bpe.cloneFilter(this);" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary btn-clone"><i class="fa fa-plus-circle"></i></button>
			<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger btn-clone-delete"><i class="fa fa-minus-circle"></i></button>
		</div>
	</div>
</div>
