{% if custom_fields %}
{% for field in custom_fields %}
	{% if field.type == 'int' or field.type == 'bigint' or field.type == 'tinyint' or field.type == 'float' or field.type == 'decimal' %}
	<div class="form-group filter-group-custom-{{ field.input }}">
		<label class="col-sm-{{ col1 }} control-label" for="filter[{{ field.input }}_from]">{{ field.label }}</label>
		<div class="col-sm-{{ col2 - 5 }}">
			<input type="text" name="filter[{{ field.input }}_from]" value="" placeholder="{{ entry_price_from }}" id="filter[{{ field.input }}_from]" class="form-control" />
		</div>
		<label class="col-sm-2 control-label" style="text-align:center;"><i class="fa fa-minus"></i></label>
		<div class="col-sm-{{ col2 - 5 }}">
			<input type="text" name="filter[{{ field.input }}_till]" value="" placeholder="{{ entry_price_to }}" id="filter[{{ field.input }}_till]" class="form-control" />
		</div>
		<div class="col-sm-{{ col3 }} hide-filter">
		<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
		</div>
	</div>
	{% elseif field.type == 'date' or field.type == 'datetime' %}
	<div class="form-group filter-group-custom-{{ field.input }}">
		<label class="col-sm-{{ col1 }} control-label" for="filter[{{ field.input }}_from]">{{ field.label }}</label>
		<div class="col-sm-{{ col2 - 5 }}">
			<div class="input-group date">
				<input type="text" name="filter[{{ field.input }}_from]" value="" placeholder="{{ entry_price_from }}" data-date-format="YYYY-MM-DD HH:mm:ss" data-locale="{{ datepicker }}" id="filter[{{ field.input }}_from]" class="form-control" />
				<div class="input-group-btn">
					<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
				</div>
			</div>
		</div>
		<label class="col-sm-2 control-label" style="text-align:center;"><i class="fa fa-minus"></i></label>
		<div class="col-sm-{{ col2 - 5 }}">
			<div class="input-group date">
				<input type="text" name="filter[{{ field.input }}_till]" value="" placeholder="{{ entry_price_to }}" data-date-format="YYYY-MM-DD HH:mm:ss" data-locale="{{ datepicker }}" id="filter[{{ field.input }}_till]" class="form-control" />
				<div class="input-group-btn">
					<button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
				</div>
			</div>
		</div>
		<div class="col-sm-{{ col3 }} hide-filter">
		<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
		</div>
	</div>
	{% else %}
	{# if field.type == 'char' or field.type == 'varchar' or field.type == 'text' or field.type == 'mediumtext' or field.type == 'longtext' #}
	<div class="form-group filter-group-custom-{{ field.input }}">
		<label class="col-sm-{{ col1 }} control-label" for="filter[{{ field.input }}]">{{ field.label }}</label>
		<div class="col-sm-{{ col2 }}">
			<input type="text" name="filter[{{ field.input }}]" value="" placeholder="{{ field.label }}" id="filter[{{ field.input }}]" class="form-control" />
			<div class="row form-row">
				<div class="btn-group" data-toggle="buttons">
					<label class="btn btn-default active" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').show();">
					<input name="filter[{{ field.input }}_contains]" value="contains" checked="checked" type="radio">{{ entry_contains }}
					</label>
					<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
					<input name="filter[{{ field.input }}_contains]" value="starts" type="radio">{{ entry_starts }}
					</label>
					<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
					<input name="filter[{{ field.input }}_contains]" value="ends" type="radio">{{ entry_ends }}
					</label>
					<label class="btn btn-default" data-toggle="tooltip" title="{{ info_contains }}" onclick="$('.batch-wr .filter-{{ field.input }}-condition').hide();">
					<input name="filter[{{ field.input }}_contains]" value="empty" type="radio">{{ entry_empty }}
					</label>
				</div>
				&nbsp;&nbsp;
				<div class="btn-group filter-{{ field.input }}-condition" data-toggle="buttons">
					<label class="btn btn-default active" data-toggle="tooltip" title="{{ info_or }}">
					<input name="filter[{{ field.input }}_or]" value="and" checked="checked" type="radio">{{ entry_and }}
					</label>
					<label class="btn btn-default" data-toggle="tooltip" title="{{ info_or }}">
					<input name="filter[{{ field.input }}_or]" value="or" type="radio">{{ entry_or }}
					</label>
					<label class="btn btn-default" data-toggle="tooltip" title="{{ info_or }}">
					<input name="filter[{{ field.input }}_or]" value="equal" type="radio">{{ entry_equal }}
					</label>
				</div>
			</div>
		</div>
		<div class="col-sm-{{ col3 }} hide-filter">
		<button type="button" onclick="bpe.hideFilter(this);" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button>
		</div>
	</div>
	{% endif %}
{% endfor %}
{% endif %}

